<section class="page-heading">
    <div>
        <span class="eyebrow">@Source</span>
        <h1>Pedido @ExternalOrderId</h1>
        <p>@Status</p>
    </div>
    <div class="page-actions">
        <a href="/Orders" class="btn btn-outline-secondary">Voltar para pedidos</a>
        @if (!ProductionTasks.Any())
        {
            <form action="/Orders/SendToProduction/@OrderId" method="post">
                <input name="__RequestVerificationToken" type="hidden" value="@RequestVerificationToken" />
                <button type="submit" class="btn btn-primary">Enviar para producao</button>
            </form>
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="alert alert-success">@SuccessMessage</div>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(StockAlertsMessage))
{
    <div class="alert alert-warning">@StockAlertsMessage</div>
}

<div class="metric-row mb-4">
    <div class="metric-card metric-card-with-icon">
        <span class="metric-icon text-center" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h10M4 17h7" /></svg>
        </span>
        <div>
            <span>Origem</span>
            <strong>@Source</strong>
        </div>
    </div>
    <div class="metric-card metric-card-with-icon">
        <span class="metric-icon text-center" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0" /></svg>
        </span>
        <div>
            <span>Data de envio</span>
            <strong>@ShippingDate</strong>
        </div>
    </div>
    <div class="metric-card metric-card-with-icon">
        <span class="metric-icon text-center" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 12l4 4L19 6" /></svg>
        </span>
        <div>
            <span>Status</span>
            <strong>@Status</strong>
        </div>
    </div>
</div>

<ul class="nav nav-tabs order-tabs" id="order-detail-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="items-tab" data-toggle="tab" data-target="#items-panel" type="button" role="tab" aria-controls="items-panel" aria-selected="true">Itens</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="production-tab" data-toggle="tab" data-target="#production-panel" type="button" role="tab" aria-controls="production-panel" aria-selected="false">Producao</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="shipments-tab" data-toggle="tab" data-target="#shipments-panel" type="button" role="tab" aria-controls="shipments-panel" aria-selected="false">Envios</button>
    </li>
</ul>

<div class="tab-content order-tab-content">
    <section class="tab-pane fade show active" id="items-panel" role="tabpanel" aria-labelledby="items-tab" tabindex="0">
        <div class="section-toolbar">
            <h2>Itens</h2>
            <a href="/ManualOrders/LinkItems/@OrderId" class="btn btn-outline-secondary">Vincular produtos internos</a>
        </div>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Item externo</th>
                        <th>Descricao</th>
                        <th>Quantidade</th>
                        <th>Produto interno</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Items)
                    {
                        <tr>
                            <td>@item.ExternalItemId</td>
                            <td>@item.Description</td>
                            <td>@item.Quantity</td>
                            <td>@item.ProductId</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="tab-pane fade" id="production-panel" role="tabpanel" aria-labelledby="production-tab" tabindex="0">
        <h2>Producao</h2>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Tarefa</th>
                        <th>Produto</th>
                        <th>Quantidade</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in ProductionTasks)
                    {
                        <tr>
                            <td>@task.Id</td>
                            <td>@task.ProductId</td>
                            <td>@task.Quantity</td>
                            <td>@task.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="tab-pane fade" id="shipments-panel" role="tabpanel" aria-labelledby="shipments-tab" tabindex="0">
        <div class="section-toolbar">
            <h2>Envios</h2>
            <a href="/Shipments/Create?orderId=@OrderId" class="btn btn-outline-secondary">Criar envio</a>
        </div>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Rastreio</th>
                        <th>Status</th>
                        <th>Criado em</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shipment in Shipments)
                    {
                        <tr>
                            <td>@shipment.TrackingCode</td>
                            <td>@shipment.Status</td>
                            <td>@shipment.CreatedAt</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    [Parameter] public Guid OrderId { get; set; }
    [Parameter] public string Source { get; set; } = string.Empty;
    [Parameter] public string ExternalOrderId { get; set; } = string.Empty;
    [Parameter] public string Status { get; set; } = string.Empty;
    [Parameter] public string ShippingDate { get; set; } = "-";
    [Parameter] public string? SuccessMessage { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? StockAlertsMessage { get; set; }
    [Parameter] public string RequestVerificationToken { get; set; } = string.Empty;
    [Parameter] public IReadOnlyCollection<OrderItemRow> Items { get; set; } = [];
    [Parameter] public IReadOnlyCollection<ProductionTaskRow> ProductionTasks { get; set; } = [];
    [Parameter] public IReadOnlyCollection<ShipmentRow> Shipments { get; set; } = [];

    public sealed record OrderItemRow(string ExternalItemId, string Description, int Quantity, string ProductId);
    public sealed record ProductionTaskRow(Guid Id, Guid ProductId, int Quantity, string Status);
    public sealed record ShipmentRow(string? TrackingCode, string Status, string CreatedAt);
}
