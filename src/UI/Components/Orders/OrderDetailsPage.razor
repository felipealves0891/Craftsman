@using System.Diagnostics.CodeAnalysis
<section class="page-heading">
    <div>
        <span class="eyebrow">@Source</span>
        <h1>Pedido @ExternalOrderId</h1>
        <p>@Status</p>
    </div>
    <div class="page-actions">
        <a href="/Orders" class="btn btn-outline-secondary">Voltar para pedidos</a>
        @if (CanChangeOrder)
        {
            <a href="/ManualOrders/Edit/@OrderId" class="btn btn-outline-primary">Editar</a>
        }
        <form action="/Orders/Delete/@OrderId" method="post">
            <input name="__RequestVerificationToken" type="hidden" value="@RequestVerificationToken" />
            <input name="processId" type="hidden" value="@DeleteProcessId" />
            <button type="submit" class="btn btn-outline-danger">Excluir</button>
        </form>
        @if (!ProductionTasks.Any() && ProductionPreflight is not null)
        {
            <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#production-preflight-modal">
                Conferir estoque e enviar para producao
            </button>
        }
        @if (CanRevertProduction)
        {
            <form action="/Orders/RevertProduction/@OrderId" method="post">
                <input name="__RequestVerificationToken" type="hidden" value="@RequestVerificationToken" />
                <button type="submit" class="btn btn-outline-warning">Reverter envio para producao</button>
            </form>
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="alert alert-success">@SuccessMessage</div>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(StockAlertsMessage))
{
    <div class="alert alert-warning">@StockAlertsMessage</div>
}

@if (!ProductionTasks.Any() && ProductionPreflight is not null)
{
    <div class="modal fade" id="production-preflight-modal" tabindex="-1" role="dialog" aria-labelledby="production-preflight-title" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="production-preflight-title">Conferir estoque para producao</h2>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(ProductionPreflight.FailureMessage))
                    {
                        <div class="alert alert-danger" role="alert">@ProductionPreflight.FailureMessage</div>
                    }
                    @if (ProductionPreflight.Products.Count == 0 && ProductionPreflight.Materials.Count == 0)
                    {
                        <p class="mb-0">Nao foi possivel determinar os materiais necessarios. Corrija os pre-requisitos e atualize o pedido.</p>
                    }
                    else
                    {
                        <p>Confira os materiais necessarios antes de confirmar o envio.</p>
                        @if (ProductionPreflight.Products.Count > 0)
                        {
                            <h3 class="h6 mt-3">Materiais por produto</h3>
                            @foreach (var product in ProductionPreflight.Products)
                            {
                                <details class="production-product-breakdown mb-3" open>
                                    <summary class="font-weight-bold">@product.Name — quantidade @product.Quantity</summary>
                                    <div class="table-responsive mt-2">
                                        <table class="table table-sm" aria-label="Materiais do produto @product.Name">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Materia-prima</th>
                                                    <th scope="col">Necessario no produto</th>
                                                    <th scope="col">Estoque global</th>
                                                    <th scope="col">Unidade</th>
                                                    <th scope="col">Situacao</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var material in product.Materials)
                                                {
                                                    var blocked = !material.IsAvailable;
                                                    <tr class="@(blocked ? "table-danger" : null)">
                                                        <th scope="row">@material.Name</th>
                                                        <td>@material.RequiredQuantity</td>
                                                        <td>@material.AvailableQuantity</td>
                                                        <td>@material.UnitOfMeasure</td>
                                                        <td>
                                                            @if (!material.IsConfigured)
                                                            {
                                                                <span class="text-danger">Erro de configuracao</span>
                                                            }
                                                            else if (blocked)
                                                            {
                                                                <span class="text-danger">Estoque insuficiente (faltam @material.MissingQuantity @material.UnitOfMeasure)</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-success">Disponivel</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </details>
                            }
                        }
                        @if (ProductionPreflight.Materials.Count > 0)
                        {
                            <h3 class="h6 mt-4">Resumo consolidado do pedido</h3>
                            <p class="small text-muted">O estoque exibido abaixo e global e compartilhado entre os produtos.</p>
                            <div class="table-responsive">
                                <table class="table table-sm" aria-label="Resumo consolidado de materiais">
                                    <thead>
                                        <tr>
                                            <th scope="col">Materia-prima</th>
                                            <th scope="col">Necessario no pedido</th>
                                            <th scope="col">Estoque global</th>
                                            <th scope="col">Unidade</th>
                                            <th scope="col">Situacao</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var material in ProductionPreflight.Materials)
                                        {
                                            var blocked = !material.IsAvailable;
                                            <tr class="@(blocked ? "table-danger" : null)">
                                                <th scope="row">@material.Name</th>
                                                <td>@material.RequiredQuantity</td>
                                                <td>@material.AvailableQuantity</td>
                                                <td>@material.UnitOfMeasure</td>
                                                <td>
                                                    @if (!material.IsConfigured)
                                                    {
                                                        <span class="text-danger">Erro de configuracao</span>
                                                    }
                                                    else if (blocked)
                                                    {
                                                        <span class="text-danger">Estoque insuficiente (faltam @material.MissingQuantity @material.UnitOfMeasure)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-success">Disponivel</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancelar</button>
                    <form action="/Orders/SendToProduction/@OrderId" method="post">
                        <input name="__RequestVerificationToken" type="hidden" value="@RequestVerificationToken" />
                        <button type="submit" class="btn btn-primary" disabled="@(!ProductionPreflight.CanConfirm)">Confirmar envio para producao</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<div class="metric-row mb-4">
    <div class="metric-card metric-card-with-icon">
        <span class="metric-icon text-center" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h10M4 17h7" /></svg>
        </span>
        <div>
            <span>Origem</span>
            <strong>@Source</strong>
        </div>
    </div>
    <div class="metric-card metric-card-with-icon">
        <span class="metric-icon text-center" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0" /></svg>
        </span>
        <div>
            <span>Data de envio</span>
            <strong>@ShippingDate</strong>
        </div>
    </div>
    <div class="metric-card metric-card-with-icon">
        <span class="metric-icon text-center" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 12l4 4L19 6" /></svg>
        </span>
        <div>
            <span>Status</span>
            <strong>@Status</strong>
        </div>
    </div>
</div>

<div class="metric-row mb-4">
    <div class="metric-card">
        <span>Cliente</span>
        <strong>@(string.IsNullOrWhiteSpace(CustomerName) ? "Sem cliente" : CustomerName)</strong>
        @if (!string.IsNullOrWhiteSpace(CustomerPhone) || !string.IsNullOrWhiteSpace(CustomerEmail))
        {
            <small>@CustomerPhone @CustomerEmail</small>
        }
    </div>
    <div class="metric-card">
        <span>Desconto</span>
        <strong>@(DiscountAmount > 0 ? DiscountAmount.ToString("C") : "Sem desconto")</strong>
        @if (DiscountAmount > 0 && !string.IsNullOrWhiteSpace(DiscountDescription))
        {
            <small>@DiscountDescription</small>
        }
    </div>
</div>

<ul class="nav nav-tabs order-tabs" id="order-detail-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="items-tab" data-toggle="tab" data-target="#items-panel" type="button" role="tab" aria-controls="items-panel" aria-selected="true">Itens</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="production-tab" data-toggle="tab" data-target="#production-panel" type="button" role="tab" aria-controls="production-panel" aria-selected="false">Producao</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="shipments-tab" data-toggle="tab" data-target="#shipments-panel" type="button" role="tab" aria-controls="shipments-panel" aria-selected="false">Envios</button>
    </li>
</ul>

<div class="tab-content order-tab-content">
    <section class="tab-pane fade show active" id="items-panel" role="tabpanel" aria-labelledby="items-tab" tabindex="0">
        <div class="section-toolbar">
            <h2>Itens</h2>
            <a href="/ManualOrders/LinkItems/@OrderId" class="btn btn-outline-secondary">Vincular produtos internos</a>
        </div>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Item externo</th>
                        <th>Descricao</th>
                        <th>Quantidade</th>
                        <th>Produto interno</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Items)
                    {
                        <tr>
                            <td>@item.ExternalItemId</td>
                            <td>@item.Description</td>
                            <td>@item.Quantity</td>
                            <td>@item.ProductId</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="tab-pane fade" id="production-panel" role="tabpanel" aria-labelledby="production-tab" tabindex="0">
        <h2>Producao</h2>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Tarefa</th>
                        <th>Produto</th>
                        <th>Quantidade</th>
                        <th>Status</th>
                        <th>Acoes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in ProductionTasks)
                    {
                        <tr>
                            <td>@task.Id</td>
                            <td>@task.ProductId</td>
                            <td>@task.Quantity</td>
                            <td>@task.Status</td>
                            <td>
                                <form action="/Production/Advance" method="post" class="production-task-actions">
                                    <input name="__RequestVerificationToken" type="hidden" value="@RequestVerificationToken" />
                                    <input type="hidden" name="id" value="@task.Id" />
                                    <input type="hidden" name="returnOrderId" value="@OrderId" />
                                    <button type="submit" name="action" value="start" class="btn btn-sm btn-outline-primary" title="Iniciar" aria-label="Iniciar" disabled="@(!task.CanStart)">
                                        <i class="fas fa-play" aria-hidden="true"></i>
                                    </button>
                                    <button type="submit" name="action" value="complete" class="btn btn-sm btn-outline-success" title="Concluir" aria-label="Concluir" disabled="@(!task.CanComplete)">
                                        <i class="fas fa-check" aria-hidden="true"></i>
                                    </button>
                                    <button type="submit" name="action" value="cancel" class="btn btn-sm btn-outline-danger" title="Cancelar" aria-label="Cancelar" disabled="@(!task.CanCancel)" onclick="return confirm('Confirma o cancelamento desta tarefa?');">
                                        <i class="fas fa-times" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="tab-pane fade" id="shipments-panel" role="tabpanel" aria-labelledby="shipments-tab" tabindex="0">
        <div class="section-toolbar">
            <h2>Envios</h2>
            <a href="/Shipments/Create?orderId=@OrderId" class="btn btn-outline-secondary">Criar envio</a>
        </div>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Rastreio</th>
                        <th>Status</th>
                        <th>Criado em</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shipment in Shipments)
                    {
                        <tr>
                            <td>@shipment.TrackingCode</td>
                            <td>@shipment.Status</td>
                            <td>@shipment.CreatedAt</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    [Parameter] public Guid OrderId { get; set; }
    [Parameter] public string Source { get; set; } = string.Empty;
    [Parameter] public string ExternalOrderId { get; set; } = string.Empty;
    [Parameter] public string? CustomerName { get; set; }
    [Parameter] public string? CustomerPhone { get; set; }
    [Parameter] public string? CustomerEmail { get; set; }
    [Parameter] public string? DiscountDescription { get; set; }
    [Parameter] public decimal DiscountAmount { get; set; }
    [Parameter] public string Status { get; set; } = string.Empty;
    [Parameter] public string ShippingDate { get; set; } = "-";
    [Parameter] public string? SuccessMessage { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? StockAlertsMessage { get; set; }
    [Parameter] public bool CanChangeOrder { get; set; }
    [Parameter] public Guid DeleteProcessId { get; set; }
    [Parameter] public string RequestVerificationToken { get; set; } = string.Empty;
    [Parameter] public IReadOnlyCollection<OrderItemRow> Items { get; set; } = [];
    [Parameter] public IReadOnlyCollection<ProductionTaskRow> ProductionTasks { get; set; } = [];
    [Parameter] public IReadOnlyCollection<ShipmentRow> Shipments { get; set; } = [];
    [Parameter] public ProductionPreflightRow? ProductionPreflight { get; set; }

    private bool CanRevertProduction =>
        Status is "Pronto para producao" or "Em producao"
        && ProductionTasks.Count > 0
        && !ProductionTasks.Any(task => task.Status == "Concluida")
        && !Shipments.Any();

    [ExcludeFromCodeCoverage]
    public sealed record OrderItemRow(string ExternalItemId, string Description, int Quantity, string ProductId);
    [ExcludeFromCodeCoverage]
    public sealed record ProductionTaskRow(
        Guid Id,
        Guid ProductId,
        int Quantity,
        string Status,
        bool CanStart = false,
        bool CanComplete = false,
        bool CanCancel = false);
    [ExcludeFromCodeCoverage]
    public sealed record ShipmentRow(string? TrackingCode, string Status, string CreatedAt);
    [ExcludeFromCodeCoverage]
    public sealed record ProductionPreflightRow(
        bool CanConfirm,
        string? FailureMessage,
        IReadOnlyCollection<ProductionPreflightProductRow> Products,
        IReadOnlyCollection<ProductionPreflightMaterialRow> Materials);
    [ExcludeFromCodeCoverage]
    public sealed record ProductionPreflightProductRow(
        Guid ProductId,
        string Name,
        int Quantity,
        IReadOnlyCollection<ProductionPreflightProductMaterialRow> Materials);
    [ExcludeFromCodeCoverage]
    public sealed record ProductionPreflightProductMaterialRow(
        Guid RawMaterialId,
        string Name,
        string UnitOfMeasure,
        decimal RequiredQuantity,
        decimal AvailableQuantity,
        decimal MissingQuantity,
        bool IsConfigured,
        bool IsAvailable);
    [ExcludeFromCodeCoverage]
    public sealed record ProductionPreflightMaterialRow(
        Guid RawMaterialId,
        string Name,
        string UnitOfMeasure,
        decimal RequiredQuantity,
        decimal AvailableQuantity,
        decimal MissingQuantity,
        bool IsConfigured,
        bool IsAvailable);
}
