<section class="page-heading">
    <div>
        <span class="eyebrow">Financeiro</span>
        <h1>Acerto financeiro</h1>
        <p>Pedido @OrderId</p>
    </div>
    <a href="/Finance" class="btn btn-outline-secondary">Voltar para apuracao</a>
</section>

<div class="metric-row mb-4">
    <div class="metric-card">
        <span>Receita</span>
        <strong>@RevenueAmount.ToString("C")</strong>
    </div>
    <div class="metric-card">
        <span>Custo total</span>
        <strong>@TotalCostAmount.ToString("C")</strong>
    </div>
    <div class="metric-card">
        <span>Margem</span>
        <strong>@MarginAmount.ToString("C")</strong>
    </div>
</div>

<div class="finance-detail-grid">
    <section class="table-panel finance-detail-summary" aria-labelledby="settlement-summary-title">
        <dl class="finance-detail-list">
            <div>
                <dt>Pedido</dt>
                <dd>@OrderId</dd>
            </div>
            <div>
                <dt>Status</dt>
                <dd>@Status</dd>
            </div>
            <div>
                <dt>Calculado em</dt>
                <dd>@CalculatedAt.ToLocalTime().ToString("g")</dd>
            </div>
            <div>
                <dt>Custo de produ&ccedil;&atilde;o</dt>
                <dd>@ProductionCostAmount.ToString("C")</dd>
            </div>
            <div>
                <dt>Custo de envio</dt>
                <dd>@ShippingCostAmount.ToString("C")</dd>
            </div>
            <div>
                <dt>Desconto</dt>
                <dd>@DiscountAmount.ToString("C")</dd>
            </div>
        </dl>
    </section>

    <section class="table-panel finance-detail-items" aria-labelledby="settlement-items-title">
        @if (!Items.Any())
        {
            <div class="empty-state">
                <strong>Nenhum item encontrado</strong>
                <span>Os dados do acerto foram carregados, mas nao ha itens disponiveis para este pedido.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Item externo</th>
                            <th>Descricao</th>
                            <th>Quantidade</th>
                            <th>Valor unitario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Items)
                        {
                            <tr>
                                <td>@item.ExternalItemId</td>
                                <td>@item.Description</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    [Parameter]
    public Guid OrderId { get; set; }

    [Parameter]
    public decimal RevenueAmount { get; set; }

    [Parameter]
    public decimal ProductionCostAmount { get; set; }

    [Parameter]
    public decimal ShippingCostAmount { get; set; }

    [Parameter]
    public decimal DiscountAmount { get; set; }

    [Parameter]
    public decimal TotalCostAmount { get; set; }

    [Parameter]
    public decimal MarginAmount { get; set; }

    [Parameter]
    public string Status { get; set; } = string.Empty;

    [Parameter]
    public DateTimeOffset CalculatedAt { get; set; }

    [Parameter]
    public IReadOnlyCollection<OrderItemRow> Items { get; set; } = [];

    public sealed record OrderItemRow(
        string ExternalItemId,
        string Description,
        int Quantity,
        string UnitPrice);
}
