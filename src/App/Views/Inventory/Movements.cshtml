@model Craftsman.App.Models.StockMovementInputModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Movimentos de estoque";
    var rawMaterials = ViewBag.RawMaterials as List<SelectListItem> ?? [];
    var movements = ViewBag.Movements as IReadOnlyCollection<Craftsman.App.Models.StockMovementViewModel> ?? [];
    var criticalAlerts = ViewBag.CriticalStockAlerts as IReadOnlyCollection<Craftsman.App.Models.StockAlertViewModel> ?? [];
}

<section class="page-heading">
    <div>
        <span class="eyebrow">Estoque</span>
        <h1>Movimentos de estoque</h1>
        <p>Registre entradas, saídas e ajustes com custo e referência operacional.</p>
    </div>
    <a asp-action="Balances" class="btn btn-outline-secondary">Ver saldos</a>
</section>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (criticalAlerts.Any())
{
    <div class="alert alert-danger">
        <strong>Estoque critico:</strong>
        @string.Join(" | ", criticalAlerts.Select(alert => $"{alert.RawMaterialName}: {alert.Balance} {alert.UnitOfMeasure} (limite {alert.ReachedLimit})"))
    </div>
}

<form asp-action="Movements" method="post" class="form-panel mb-4">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }
    <div class="row">
        <div class="col-md-3 form-group">
            <label asp-for="RawMaterialId" class="form-label"></label>
            <select asp-for="RawMaterialId" asp-items="rawMaterials" class="form-select"></select>
        </div>
        <div class="col-md-2 form-group">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" asp-items="Html.GetEnumSelectList<Craftsman.Domain.Inventory.Entities.StockMovementType>()" class="form-select" data-stock-movement-type></select>
        </div>
        <div class="col-md-2 form-group">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" type="text" inputmode="numeric" class="form-control" data-numeric-input />
        </div>
        <div class="col-md-2 form-group">
            <label asp-for="UnitCostAmount" class="form-label"></label>
            <input asp-for="UnitCostAmount" type="text" inputmode="decimal" class="form-control" data-currency-input />
        </div>
        <div class="col-md-3 form-group" data-stock-movement-reason-group>
            <label asp-for="Reason" class="form-label"></label>
            <input asp-for="Reason" class="form-control" data-stock-movement-reason />
            <span asp-validation-for="Reason" class="text-danger"></span>
        </div>
        <div class="col-md-2 d-flex align-items-end form-group">
            <button type="submit" class="btn btn-primary w-100">Registrar</button>
        </div>
    </div>
</form>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Matéria-prima</th>
                    <th>Tipo</th>
                    <th>Quantidade</th>
                    <th>Custo unitário</th>
                    <th>Total</th>
                    <th>Motivo</th>
                    <th>Referência</th>
                    <th>Data</th>
                </tr>
            </thead>
            <tbody>
                @if (!movements.Any())
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <strong>Nenhum movimento registrado</strong>
                                <span>Registre o primeiro movimento usando o formulário acima.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var movement in movements)
                    {
                        <tr>
                            <td><strong>@movement.RawMaterialName</strong></td>
                            <td>@movement.Type</td>
                            <td>@movement.Quantity.ToString("#")</td>
                            <td>@movement.UnitCostAmount.ToString("C")</td>
                            <td><strong>@movement.TotalCostAmount.ToString("C")</strong></td>
                            <td>@movement.Reason</td>
                            <td>@movement.BusinessReference</td>
                            <td>@movement.OccurredAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const typeField = document.querySelector("[data-stock-movement-type]");
            const reasonGroup = document.querySelector("[data-stock-movement-reason-group]");
            const reasonField = document.querySelector("[data-stock-movement-reason]");

            if (!typeField || !reasonGroup || !reasonField) {
                return;
            }

            const outboundValue = "2";
            const updateReasonVisibility = () => {
                const isOutbound = typeField.value === outboundValue;
                reasonGroup.hidden = !isOutbound;
                reasonField.required = isOutbound;
                reasonField.disabled = !isOutbound;
                if (!isOutbound) {
                    reasonField.value = "";
                }
            };

            typeField.addEventListener("change", updateReasonVisibility);
            updateReasonVisibility();
        })();
    </script>
}
