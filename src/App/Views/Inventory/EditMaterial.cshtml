@model Craftsman.App.Models.RawMaterialInputModel

@{
    ViewData["Title"] = Model.Id.HasValue ? "Editar materia-prima" : "Nova materia-prima";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="EditMaterial" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="UnitOfMeasure" class="form-label"></label>
        <input asp-for="UnitOfMeasure" class="form-control" />
        <span asp-validation-for="UnitOfMeasure" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<Craftsman.Domain.Inventory.Entities.RawMaterialStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="MinimumStockLevel" class="form-label"></label>
            <input asp-for="MinimumStockLevel" type="text" inputmode="decimal" class="form-control" data-decimal-input />
            <span asp-validation-for="MinimumStockLevel" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="CriticalStockLevel" class="form-label"></label>
            <input asp-for="CriticalStockLevel" type="text" inputmode="decimal" class="form-control" data-decimal-input />
            <span asp-validation-for="CriticalStockLevel" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
