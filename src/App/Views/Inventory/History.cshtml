@model IReadOnlyCollection<Craftsman.App.Models.StockMovementViewModel>

@{
    ViewData["Title"] = "Historico de estoque";
    var movements = Model
        .Select(movement => new InventoryHistoryPage.MovementRow(
            Craftsman.App.Presentation.EnumPresentation.Label(typeof(Craftsman.Domain.Inventory.Entities.StockMovementType), movement.Type),
            movement.Quantity.ToString(),
            movement.UnitCostAmount.ToString("C"),
            movement.TotalCostAmount.ToString("C"),
            movement.Reason,
            movement.BusinessReference ?? string.Empty,
            movement.OccurredAt.ToLocalTime().ToString("g")))
        .ToArray();
}

<component type="typeof(InventoryHistoryPage)" render-mode="Static" param-Movements="@movements" />
