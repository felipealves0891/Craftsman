@model IReadOnlyCollection<Craftsman.App.Models.StockMovementViewModel>

@{
    ViewData["Title"] = "Historico de estoque";
}

<h1>Historico de estoque</h1>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Tipo</th>
            <th>Quantidade</th>
            <th>Custo unitario</th>
            <th>Total</th>
            <th>Motivo</th>
            <th>Referencia</th>
            <th>Data</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movement in Model)
        {
            <tr>
                <td>@movement.Type</td>
                <td>@movement.Quantity</td>
                <td>@movement.UnitCostAmount.ToString("C")</td>
                <td>@movement.TotalCostAmount.ToString("C")</td>
                <td>@movement.Reason</td>
                <td>@movement.BusinessReference</td>
                <td>@movement.OccurredAt.ToLocalTime().ToString("g")</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Balances" class="btn btn-outline-secondary">Voltar</a>
