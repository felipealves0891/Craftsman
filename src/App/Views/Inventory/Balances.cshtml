@model IReadOnlyCollection<Craftsman.App.Models.InventoryBalanceViewModel>

@{
    ViewData["Title"] = "Saldos";
}

<section class="page-heading">
    <div>
        <span class="eyebrow">Estoque</span>
        <h1>Saldos de estoque</h1>
        <p>Consulte rapidamente a disponibilidade de cada matéria-prima.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar para matérias-primas</a>
</section>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Matéria-prima</th>
                    <th>Saldo</th>
                    <th class="text-right">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3">
                            <div class="empty-state">
                                <strong>Nenhum saldo registrado</strong>
                                <span>Cadastre matérias-primas e movimentos para acompanhar o estoque.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var balance in Model)
                    {
                        <tr>
                            <td><strong>@balance.RawMaterialName</strong></td>
                            <td>@balance.Balance @balance.UnitOfMeasure</td>
                            <td class="text-right"><a asp-action="History" asp-route-id="@balance.RawMaterialId" class="btn btn-sm btn-outline-primary">Histórico</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
