@model IReadOnlyCollection<Craftsman.App.Models.InventoryBalanceViewModel>

@{
    ViewData["Title"] = "Saldos";

    static string AlertMarkup(Craftsman.Domain.Inventory.Entities.StockAlertLevel alertLevel, decimal? reachedLimit) => alertLevel switch
    {
        Craftsman.Domain.Inventory.Entities.StockAlertLevel.Critical => $"<span class=\"badge badge-danger\">Critico</span> <span class=\"small text-muted\">limite {reachedLimit}</span>",
        Craftsman.Domain.Inventory.Entities.StockAlertLevel.Warning => $"<span class=\"badge badge-warning\">Aviso</span> <span class=\"small text-muted\">limite {reachedLimit}</span>",
        _ => "<span class=\"text-muted\">Normal</span>"
    };

    var balances = Model
        .Select(balance => new InventoryBalancesPage.BalanceRow(
            balance.RawMaterialId,
            balance.RawMaterialName,
            balance.Balance.ToString("0"),
            balance.UnitOfMeasure,
            AlertMarkup(balance.AlertLevel, balance.ReachedLimit)))
        .ToArray();
}

<component type="typeof(InventoryBalancesPage)" render-mode="Static" param-Balances="@balances" />
