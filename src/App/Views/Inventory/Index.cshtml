@model IReadOnlyCollection<Craftsman.App.Models.RawMaterialListItemViewModel>

@{
    ViewData["Title"] = "Estoque";

    static string AlertMarkup(Craftsman.Domain.Inventory.Entities.StockAlertLevel? alertLevel) => alertLevel switch
    {
        Craftsman.Domain.Inventory.Entities.StockAlertLevel.Critical => $"<span class=\"badge badge-danger\">{Craftsman.App.Presentation.EnumPresentation.Label(Craftsman.Domain.Inventory.Entities.StockAlertLevel.Critical)}</span>",
        Craftsman.Domain.Inventory.Entities.StockAlertLevel.Warning => $"<span class=\"badge badge-warning\">{Craftsman.App.Presentation.EnumPresentation.Label(Craftsman.Domain.Inventory.Entities.StockAlertLevel.Warning)}</span>",
        _ => $"<span class=\"text-muted\">{Craftsman.App.Presentation.EnumPresentation.Label(Craftsman.Domain.Inventory.Entities.StockAlertLevel.Normal)}</span>"
    };

    var materials = Model
        .Select(material => new InventoryIndexPage.MaterialRow(
            material.Id,
            material.Name,
            material.UnitOfMeasure,
            Craftsman.App.Presentation.EnumPresentation.Label(typeof(Craftsman.Domain.Inventory.Entities.RawMaterialStatus), material.Status),
            material.Status.ToLowerInvariant(),
            material.MinimumStockLevel?.ToString("0") ?? "-",
            material.CriticalStockLevel?.ToString("0") ?? "-",
            AlertMarkup(material.AlertLevel)))
        .ToArray();
}

<component type="typeof(InventoryIndexPage)" render-mode="Static" param-Materials="@materials" />
