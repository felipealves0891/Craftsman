@model IReadOnlyCollection<Craftsman.App.Models.RawMaterialListItemViewModel>

@{
    ViewData["Title"] = "Estoque";

    static string AlertMarkup(string? alertLevel) => alertLevel switch
    {
        "Critical" => "<span class=\"badge badge-danger\">Critico</span>",
        "Warning" => "<span class=\"badge badge-warning\">Aviso</span>",
        _ => "<span class=\"text-muted\">Normal</span>"
    };

    var materials = Model
        .Select(material => new InventoryIndexPage.MaterialRow(
            material.Id,
            material.Name,
            material.UnitOfMeasure,
            material.Status.ToString(),
            material.Status.ToString().ToLowerInvariant(),
            material.MinimumStockLevel?.ToString() ?? "-",
            material.CriticalStockLevel?.ToString() ?? "-",
            AlertMarkup(material.AlertLevel.ToString())))
        .ToArray();
}

<component type="typeof(InventoryIndexPage)" render-mode="Static" param-Materials="@materials" />
