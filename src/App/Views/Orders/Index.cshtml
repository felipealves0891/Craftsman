@model Craftsman.App.Models.OrdersIndexViewModel

@{
    ViewData["Title"] = "Pedidos";
}

<section class="page-heading">
    <div>
        <span class="eyebrow">Operação</span>
        <h1>Pedidos</h1>
        <p>Importe pedidos externos, acompanhe a carteira e crie pedidos manuais quando necessário.</p>
    </div>
    <div class="page-actions">
        <form asp-action="Import" method="post">
            <button type="submit" class="btn btn-outline-secondary">Importar pedidos</button>
        </form>
        <a asp-controller="ManualOrders" asp-action="Create" class="btn btn-primary">Novo pedido</a>
    </div>
</section>

@if (Model.LastImport is not null)
{
    <div class="metric-row mb-4">
        <div class="metric-card">
            <span>Importados</span>
            <strong>@Model.LastImport.ImportedCount</strong>
        </div>
        <div class="metric-card">
            <span>Ignorados</span>
            <strong>@Model.LastImport.SkippedCount</strong>
        </div>
        <div class="metric-card">
            <span>Falhas</span>
            <strong>@Model.LastImport.Failures.Count</strong>
        </div>
    </div>

    @if (Model.LastImport.Failures.Count > 0)
    {
        <div class="alert alert-danger">
            <strong>Falhas na importação</strong>
            <ul class="mb-0 mt-2">
                @foreach (var failure in Model.LastImport.Failures)
                {
                    <li>@failure</li>
                }
            </ul>
        </div>
    }
}

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Origem</th>
            <th>Pedido externo</th>
            <th>Cliente</th>
            <th>Status</th>
            <th>Itens</th>
            <th>Criado em</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.Orders)
        {
            <tr>
                <td>@order.Source</td>
                <td>@order.ExternalOrderId</td>
                <td>@order.CustomerName</td>
                <td>@order.Status</td>
                <td>@order.ItemCount</td>
                <td>@order.CreatedAt.ToLocalTime().ToString("g")</td>
                <td><a asp-action="Details" asp-route-id="@order.Id">Detalhes</a></td>
            </tr>
        }
    </tbody>
</table>
</div>
