@model Craftsman.App.Models.OrdersIndexViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Pedidos";

    var requestVerificationToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? string.Empty;
    var orders = Model.Orders
        .Select(order => new OrdersIndexPage.OrderRow(
            order.Id,
            order.Source,
            order.ExternalOrderId,
            order.ShippingDate?.ToString("dd/MM/yyyy") ?? "-",
            Craftsman.App.Presentation.EnumPresentation.Label(typeof(Craftsman.Domain.Sales.Entities.OrderStatus), order.Status),
            order.Status.ToLowerInvariant(),
            order.ItemCount,
            order.CreatedAt.ToLocalTime().ToString("g")))
        .ToArray();
    var lastImport = Model.LastImport is null
        ? null
        : new OrdersIndexPage.ImportSummary(
            Model.LastImport.ImportedCount,
            Model.LastImport.SkippedCount,
            Model.LastImport.Failures);
}

<component type="typeof(OrdersIndexPage)" render-mode="Static"
           param-Orders="@orders"
           param-LastImport="@lastImport"
           param-RequestVerificationToken="@requestVerificationToken" />
