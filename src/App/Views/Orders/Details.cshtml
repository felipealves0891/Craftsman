@model Craftsman.App.Models.OrderDetailViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Pedido";
    var requestVerificationToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? string.Empty;
    var items = Model.Items
        .Select(item => new OrderDetailsPage.OrderItemRow(
            item.ExternalItemId,
            item.Description,
            item.Quantity,
            item.ProductId?.ToString() ?? "Sem vinculo"))
        .ToArray();
    var productionTasks = Model.ProductionTasks
        .Select(task => new OrderDetailsPage.ProductionTaskRow(
            task.Id,
            task.ProductId,
            task.Quantity,
            Craftsman.App.Presentation.EnumPresentation.Label(typeof(Craftsman.Domain.Production.Entities.ProductionTaskStatus), task.Status)))
        .ToArray();
    var shipments = Model.Shipments
        .Select(shipment => new OrderDetailsPage.ShipmentRow(
            shipment.TrackingCode,
            Craftsman.App.Presentation.EnumPresentation.Label(typeof(Craftsman.Domain.Shipping.Entities.ShipmentStatus), shipment.Status),
            shipment.CreatedAt.ToLocalTime().ToString("g")))
        .ToArray();
    var shippingDate = Model.ShippingDate?.ToString("dd/MM/yyyy") ?? "-";
    var successMessage = TempData["Success"] as string;
    var errorMessage = TempData["Error"] as string;
    var stockAlertsMessage = TempData["StockAlerts"] as string;
    var canChangeOrder = !Model.Shipments.Any()
        && !Model.ProductionTasks.Any(task => task.Status is nameof(Craftsman.Domain.Production.Entities.ProductionTaskStatus.InProduction) or nameof(Craftsman.Domain.Production.Entities.ProductionTaskStatus.Completed));
}

<component type="typeof(OrderDetailsPage)" render-mode="Static"
           param-OrderId="@Model.Id"
           param-Source="@Model.Source"
           param-ExternalOrderId="@Model.ExternalOrderId"
           param-Status="@Craftsman.App.Presentation.EnumPresentation.Label(typeof(Craftsman.Domain.Sales.Entities.OrderStatus), Model.Status)"
           param-ShippingDate="@shippingDate"
           param-SuccessMessage="@successMessage"
           param-ErrorMessage="@errorMessage"
           param-StockAlertsMessage="@stockAlertsMessage"
           param-CanChangeOrder="@canChangeOrder"
           param-RequestVerificationToken="@requestVerificationToken"
           param-Items="@items"
           param-ProductionTasks="@productionTasks"
           param-Shipments="@shipments" />
