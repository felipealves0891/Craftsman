@model Craftsman.App.Models.ImportResultViewModel

@{
    ViewData["Title"] = "Importação";
}

<h1>Importação</h1>

<form asp-action="Run" method="post" class="mb-4">
    <button type="submit" class="btn btn-primary">Importar pedidos simulados</button>
</form>

<dl class="row">
    <dt class="col-sm-2">Importados</dt>
    <dd class="col-sm-10">@Model.ImportedCount</dd>
    <dt class="col-sm-2">Ignorados</dt>
    <dd class="col-sm-10">@Model.SkippedCount</dd>
</dl>

@if (Model.Failures.Count > 0)
{
    <h2>Falhas</h2>
    <ul>
        @foreach (var failure in Model.Failures)
        {
            <li>@failure</li>
        }
    </ul>
}
