@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var ordersActive = controller is "Import" or "Orders" or "ManualOrders";
    var catalogActive = controller is "Products" or "Inventory";
    var executionActive = controller is "Production" or "Shipments";
    var financeActive = controller is "Finance";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Craftsman</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Craftsman.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-fluid app-shell">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="app-brand-mark">C</span>
                    <span>Craftsman</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav app-nav ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link @(ordersActive ? "active" : null)" asp-area="" asp-controller="Orders" asp-action="Index">Pedidos</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(catalogActive ? "active" : null)" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Catálogo e estoque</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Products" asp-action="Index">Produtos</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Products" asp-action="Mappings">Mapeamentos</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Inventory" asp-action="Index">Matérias-primas</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Inventory" asp-action="Balances">Saldos</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Inventory" asp-action="Movements">Movimentos</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(executionActive ? "active" : null)" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Execução</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Production" asp-action="Index">Produção</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Shipments" asp-action="Index">Envios</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(financeActive ? "active" : null)" asp-area="" asp-controller="Finance" asp-action="Index">Financeiro</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid app-shell app-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container-fluid app-shell">
            <span>&copy; 2026 - Craftsman</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
