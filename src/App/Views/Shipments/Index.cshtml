@using Craftsman.Domain.Shipping.Entities
@using Craftsman.UI.Components.Shared
@model IReadOnlyCollection<Craftsman.App.Models.ShipmentListItemViewModel>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Envios";

    static string StatusLabel(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Created => "Criado",
        ShipmentStatus.InTransit => "Em transito",
        ShipmentStatus.DeliveryAttempted => "Tentativa de entrega",
        ShipmentStatus.Delivered => "Entregue",
        ShipmentStatus.Cancelled => "Cancelado",
        _ => status.ToString()
    };

    static string StatusLabelText(string status) => status switch
    {
        nameof(ShipmentStatus.Created) => "Criado",
        nameof(ShipmentStatus.InTransit) => "Em transito",
        nameof(ShipmentStatus.DeliveryAttempted) => "Tentativa de entrega",
        nameof(ShipmentStatus.Delivered) => "Entregue",
        nameof(ShipmentStatus.Cancelled) => "Cancelado",
        _ => status
    };

    var statusOptions = Enum.GetValues<ShipmentStatus>()
        .Select(status => new SelectOption(status.ToString(), StatusLabel(status), ViewBag.Status == status))
        .ToArray();
    var shipments = Model
        .Select(shipment => new ShipmentsIndexPage.ShipmentRow(
            shipment.Id,
            shipment.OrderId,
            shipment.TrackingCode,
            StatusLabelText(shipment.Status),
            shipment.Status.ToLowerInvariant(),
            shipment.CreatedAt.ToLocalTime().ToString("g")))
        .ToArray();
    var requestVerificationToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? string.Empty;
}

<component type="typeof(ShipmentsIndexPage)" render-mode="Static"
           param-StatusOptions="@statusOptions"
           param-Shipments="@shipments"
           param-RequestVerificationToken="@requestVerificationToken" />
