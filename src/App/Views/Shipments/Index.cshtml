@using Craftsman.Domain.Shipping.Entities
@using Craftsman.UI.Components.Shared
@model IReadOnlyCollection<Craftsman.App.Models.ShipmentListItemViewModel>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Envios";

    object? statusFilter = ViewBag.Status;
    var selectedStatus = statusFilter is ShipmentStatus shipmentStatus ? shipmentStatus : (ShipmentStatus?)null;
    var statusOptions = Craftsman.App.Presentation.EnumPresentation.SelectList(selectedStatus)
        .Select(status => new SelectOption(status.Value ?? string.Empty, status.Text, status.Selected))
        .ToArray();
    var shipments = Model
        .Select(shipment => new ShipmentsIndexPage.ShipmentRow(
            shipment.Id,
            shipment.OrderId,
            shipment.TrackingCode,
            Craftsman.App.Presentation.EnumPresentation.Label(typeof(ShipmentStatus), shipment.Status),
            shipment.Status.ToLowerInvariant(),
            shipment.CreatedAt.ToLocalTime().ToString("g")))
        .ToArray();
    var requestVerificationToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? string.Empty;
    var errorMessage = TempData["Error"] as string;
}

<component type="typeof(ShipmentsIndexPage)" render-mode="Static"
           param-StatusOptions="@statusOptions"
           param-Shipments="@shipments"
           param-RequestVerificationToken="@requestVerificationToken"
           param-ErrorMessage="@errorMessage" />
