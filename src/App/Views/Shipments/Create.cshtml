@using Craftsman.App.Models
@model Craftsman.App.Models.CreateShipmentInputModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Criar envio";
    var selectedOrder = Model.AvailableOrders.FirstOrDefault(order => order.Id == Model.OrderId);
    var selectedOrderText = selectedOrder?.DisplayName ?? "Nenhum pedido selecionado";
    static string FormatMoney(OrderItemViewModel item) => $"{item.UnitPrice:N2} {item.Currency}";

    var availableOrders = Model.AvailableOrders
        .Select(order =>
        {
            var searchText = string.Join(
                " ",
                order.Source,
                order.ExternalOrderId,
                order.Status,
                order.ShippingDate?.ToString("dd/MM/yyyy") ?? string.Empty,
                string.Join(" ", order.Items.Select(item => item.Description)))
                .ToLowerInvariant();
            var items = order.Items
                .Select(item => new ShipmentCreatePage.OrderSelectionItemRow(
                    item.ExternalItemId,
                    item.Description,
                    item.Quantity,
                    FormatMoney(item)))
                .ToArray();

            return new ShipmentCreatePage.OrderSelectionRow(
                order.Id,
                order.Source,
                order.ExternalOrderId,
                order.Status,
                order.ShippingDate?.ToString("dd/MM/yyyy") ?? "-",
                order.DisplayName,
                searchText,
                items);
        })
        .ToArray();
    var requestVerificationToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? string.Empty;
}

@* Static component contract: asp-for="OrderId" type="hidden" data-order-modal-trigger data-shipment-order-modal data-order-select data-order-items Descricao Quantidade Valor unitario *@
<component type="typeof(ShipmentCreatePage)" render-mode="Static"
           param-RequestVerificationToken="@requestVerificationToken"
           param-OrderId="@Model.OrderId"
           param-TrackingCode="@Model.TrackingCode"
           param-SelectedOrderText="@selectedOrderText"
           param-AvailableOrders="@availableOrders" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
