@model Craftsman.App.Models.CreateShipmentInputModel

@{
    ViewData["Title"] = "Criar envio";
}

<section class="page-heading">
    <div>
        <span class="eyebrow">Envios</span>
        <h1>Criar envio</h1>
        <p>Informe o pedido e o código de rastreio para iniciar o acompanhamento da entrega.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar para envios</a>
</section>

<form asp-action="Create" method="post" class="form-panel narrow-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="OrderId" class="form-label">Pedido</label>
        <input asp-for="OrderId" class="form-control" />
        <span asp-validation-for="OrderId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TrackingCode" class="form-label">Código de rastreio</label>
        <input asp-for="TrackingCode" class="form-control" />
        <span asp-validation-for="TrackingCode" class="text-danger"></span>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Salvar envio</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
