@model IReadOnlyCollection<Craftsman.App.Models.UserListItemViewModel>

@{
    ViewData["Title"] = "Usuarios";
    var users = Model
        .Select(user => new UsersIndexPage.UserRow(user.Email, string.Join(", ", user.Roles)))
        .ToArray();
}

<component type="typeof(UsersIndexPage)" render-mode="Static" param-Users="@users" />
