@model IReadOnlyCollection<Craftsman.App.Models.FinancialSettlementListItemViewModel>

@{
    ViewData["Title"] = "Financeiro";

    static string StatusLabel(object status) => status.ToString() switch
    {
        "Calculated" => "Calculado",
        "Failed" => "Falhou",
        _ => status.ToString() ?? "-"
    };

    var settlements = Model
        .Select(settlement => new FinanceIndexPage.SettlementRow(
            settlement.OrderId,
            settlement.RevenueAmount.ToString("C"),
            settlement.TotalCostAmount.ToString("C"),
            settlement.MarginAmount.ToString("C"),
            StatusLabel(settlement.Status),
            settlement.Status.ToString().ToLowerInvariant(),
            settlement.CalculatedAt.ToLocalTime().ToString("g")))
        .ToArray();

    var successMessage = TempData["Success"] as string;
    var errorMessage = TempData["Error"] as string;
    var from = ViewBag.From is DateOnly fromDate ? fromDate.ToString("yyyy-MM-dd") : null;
    var to = ViewBag.To is DateOnly toDate ? toDate.ToString("yyyy-MM-dd") : null;
}

<component type="typeof(FinanceIndexPage)" render-mode="Static"
           param-Settlements="@settlements"
           param-From="@from"
           param-To="@to"
           param-SuccessMessage="@successMessage"
           param-ErrorMessage="@errorMessage" />
