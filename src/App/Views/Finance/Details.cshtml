@model Craftsman.App.Models.FinancialSettlementDetailViewModel

@{
    ViewData["Title"] = "Acerto financeiro";
}

<component type="typeof(FinancialSettlementDetailsPage)" render-mode="Static"
           param-OrderId="@Model.OrderId"
           param-RevenueAmount="@Model.RevenueAmount"
           param-ProductionCostAmount="@Model.ProductionCostAmount"
           param-ShippingCostAmount="@Model.ShippingCostAmount"
           param-TotalCostAmount="@Model.TotalCostAmount"
           param-MarginAmount="@Model.MarginAmount"
           param-Status="@Craftsman.App.Presentation.EnumPresentation.Label(typeof(Craftsman.Domain.Finance.Entities.FinancialSettlementStatus), Model.Status)"
           param-CalculatedAt="@Model.CalculatedAt" />
