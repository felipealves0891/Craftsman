@{
    ViewData["Title"] = "Painel";
}

<section class="page-heading">
    <div>
        <span class="eyebrow">Operação artesanal conectada</span>
        <h1>Painel Craftsman</h1>
        <p>Controle pedidos, catálogo, estoque, produção, envios e financeiro em um fluxo único.</p>
    </div>
    <a asp-controller="ManualOrders" asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i>
        Novo pedido manual
    </a>
</section>

<div class="row">
    <div class="col-xl-3 col-md-6 mb-4">
        <a asp-controller="Orders" asp-action="Index" class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Pedidos</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">Carteira</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-shopping-cart fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <a asp-controller="Inventory" asp-action="Balances" class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Estoque</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">Saldos</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-warehouse fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <a asp-controller="Production" asp-action="Index" class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Produção</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">Agenda</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-industry fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <a asp-controller="Finance" asp-action="Index" class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Financeiro</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">Margem</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Fluxos principais</h6>
            </div>
            <div class="card-body">
                <div class="quick-grid">
                    <a asp-controller="Import" asp-action="Index" class="quick-card">
                        <span class="quick-card-kicker">Operação</span>
                        <strong>Importar pedidos</strong>
                        <span>Entrada automatizada com rastreabilidade por origem.</span>
                    </a>
                    <a asp-controller="Products" asp-action="Index" class="quick-card">
                        <span class="quick-card-kicker">Catálogo</span>
                        <strong>Produtos e fichas técnicas</strong>
                        <span>Mantenha produtos internos e consumo de materiais.</span>
                    </a>
                    <a asp-controller="Shipments" asp-action="Index" class="quick-card">
                        <span class="quick-card-kicker">Envios</span>
                        <strong>Acompanhar entregas</strong>
                        <span>Veja rastreio, status e confirmação de entrega.</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Visão integrada</h6>
            </div>
            <div class="card-body text-center">
                <img class="img-fluid px-3 px-sm-4 mt-3 mb-4" style="max-height: 13rem;" src="~/img/undraw_posting_photo.svg" alt="" />
                <p class="mb-0 text-gray-700">Cada pedido percorre catálogo, estoque, produção, envio e apuração financeira sem sair do painel.</p>
            </div>
        </div>
    </div>
</div>
