@model Craftsman.App.Models.ProductInputModel

@{
    ViewData["Title"] = Model.Id.HasValue ? "Editar produto" : "Novo produto";
}

<section class="page-heading">
    <div>
        <span class="eyebrow">Catalogo</span>
        <h1>@ViewData["Title"]</h1>
        <p>Defina as informacoes comerciais e o tempo necessario para concluir a producao.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar para produtos</a>
</section>

<form asp-action="Edit" method="post" class="form-panel narrow-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="Id" type="hidden" />

    <div class="form-group">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<Craftsman.Domain.ProductCatalog.Entities.ProductStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ProductionDurationHours" class="form-label"></label>
        <input asp-for="ProductionDurationHours" class="form-control" min="1" />
        <span asp-validation-for="ProductionDurationHours" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="HourlyRate" class="form-label"></label>
        <input asp-for="HourlyRate" class="form-control" min="0" step="0.01" />
        <span asp-validation-for="HourlyRate" class="text-danger"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
