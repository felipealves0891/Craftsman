@model IReadOnlyCollection<Craftsman.App.Models.ProductListItemViewModel>

@{
    ViewData["Title"] = "Produtos";
    var products = Model
        .Select(product => new ProductsIndexPage.ProductRow(
            product.Id,
            product.Name,
            product.Status.ToString(),
            product.Status.ToString().ToLowerInvariant(),
            product.ProductionDurationHours,
            product.HourlyRate.ToString("C"),
            product.BillOfMaterialsItems))
        .ToArray();
}

<component type="typeof(ProductsIndexPage)" render-mode="Static" param-Products="@products" />
