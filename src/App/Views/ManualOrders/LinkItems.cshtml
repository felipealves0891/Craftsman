@model Craftsman.App.Models.OrderDetailViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using Craftsman.UI.Components.Shared
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Vincular itens";
    var products = (ViewBag.Products as List<SelectListItem> ?? [])
        .Select(product => new SelectOption(product.Value, product.Text, product.Selected))
        .ToArray();
    var items = Model.Items
        .Select(item => new ManualOrderLinkItemsPage.LinkItemRow(
            item.Id,
            item.ExternalItemId,
            item.Description,
            item.Quantity,
            item.ProductId?.ToString() ?? "Sem vinculo"))
        .ToArray();
    var requestVerificationToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? string.Empty;
    var errorMessage = TempData["Error"] as string;
}

<component type="typeof(ManualOrderLinkItemsPage)" render-mode="Static"
           param-OrderId="@Model.Id"
           param-Source="@Model.Source"
           param-ExternalOrderId="@Model.ExternalOrderId"
           param-ErrorMessage="@errorMessage"
           param-RequestVerificationToken="@requestVerificationToken"
           param-Items="@items"
           param-Products="@products" />
