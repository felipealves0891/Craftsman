@model Craftsman.App.Models.ManualOrderInputModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using Craftsman.UI.Components.Shared
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Novo pedido";
    var products = (ViewBag.Products as List<SelectListItem> ?? [])
        .Select(product => new SelectOption(product.Value, product.Text, product.Selected))
        .ToArray();
    var orderSources = (ViewBag.OrderSources as List<SelectListItem> ?? [])
        .Select(source => new SelectOption(source.Value, source.Text, source.Selected || source.Value == Model.Source))
        .ToArray();
    var items = Model.Items
        .Select(item => new ManualOrderCreatePage.ManualOrderItemRow(
            item.ExternalItemId,
            item.Description,
            item.Quantity,
            item.UnitPriceAmount.ToString("N2"),
            item.ProductId?.ToString()))
        .ToArray();
    var requestVerificationToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? string.Empty;
    var reference = Model.Reference ?? Guid.NewGuid().ToString()[..8];
    var shippingDate = Model.ShippingDate?.ToString("yyyy-MM-dd");
    var minimumShippingDate = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(1).ToString("yyyy-MM-dd");
    var successMessage = TempData["Success"] as string;
    var errorMessage = TempData["Error"] as string;
}

@* Static component contract: asp-for="Items[i].UnitPriceAmount" type="text" inputmode="decimal" data-currency-input *@
<component type="typeof(ManualOrderCreatePage)" render-mode="Static"
           param-Products="@products"
           param-OrderSources="@orderSources"
           param-Items="@items"
           param-RequestVerificationToken="@requestVerificationToken"
           param-Reference="@reference"
           param-ShippingDate="@shippingDate"
           param-MinimumShippingDate="@minimumShippingDate"
           param-SuccessMessage="@successMessage"
           param-ErrorMessage="@errorMessage" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
