@model Craftsman.App.Models.ManualOrderInputModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Novo pedido";
    var products = ViewBag.Products as List<SelectListItem> ?? [];
}

<section class="page-heading">
    <div>
        <span class="eyebrow">Pedido manual</span>
        <h1>Novo pedido</h1>
        <p>Informe os dados do cliente e adicione quantos itens forem necessários.</p>
    </div>
    <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary">Voltar para pedidos</a>
</section>

<form asp-action="Create" method="post" id="manual-order-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="manual-order-layout">
        <div class="manual-order-main">
            <section class="form-panel manual-order-section">
            <div class="section-title">
                <span class="section-step">1</span>
                <div>
                    <h2>Dados do pedido</h2>
                    <p>Identifique o cliente e a referência usada internamente.</p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 form-group">
                <label asp-for="Reference" class="form-label"></label>
                    <input asp-for="Reference" class="form-control" placeholder="Ex.: WhatsApp 1024" />
            </div>
                <div class="col-md-4 form-group">
                <label asp-for="CustomerName" class="form-label"></label>
                    <input asp-for="CustomerName" class="form-control" placeholder="Nome do cliente" />
                <span asp-validation-for="CustomerName" class="text-danger"></span>
            </div>
                <div class="col-md-4 form-group">
                <label asp-for="CustomerEmail" class="form-label"></label>
                    <input asp-for="CustomerEmail" class="form-control" placeholder="cliente@email.com" />
                <span asp-validation-for="CustomerEmail" class="text-danger"></span>
            </div>
            </div>
        </section>

            <section class="form-panel manual-order-section">
            <div class="section-toolbar manual-items-toolbar">
                <div class="section-title">
                    <span class="section-step">2</span>
                    <div>
                        <h2>Itens do pedido</h2>
                        <p>Adicione os produtos comprados e vincule ao catálogo interno quando possível.</p>
                    </div>
                </div>
                <button type="button" class="btn btn-outline-primary" id="add-order-item">
                    <i class="fas fa-plus fa-sm mr-1"></i>Adicionar item
                </button>
            </div>

            <div class="manual-items-list" id="order-items-body">
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    <div class="order-item-row manual-item-card">
                        <div class="manual-item-header">
                            <div>
                                <span class="manual-item-kicker">Item <span data-item-number>@(i + 1)</span></span>
                                <strong data-item-title>Novo item</strong>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-remove-item>
                                <i class="fas fa-trash-alt fa-sm mr-1"></i>Remover
                            </button>
                        </div>

                        <div class="manual-item-grid">
                            <div class="form-group">
                                <label class="form-label">Código externo</label>
                                <input asp-for="Items[i].ExternalItemId" class="form-control" placeholder="SKU, código ou referência" data-item-field />
                            </div>
                            <div class="form-group manual-item-description">
                                <label class="form-label">Descrição</label>
                                <input asp-for="Items[i].Description" class="form-control" placeholder="Produto vendido" data-item-field data-description-field />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Quantidade</label>
                                <input asp-for="Items[i].Quantity" class="form-control" data-item-field data-quantity-field />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Valor unitário</label>
                                <input asp-for="Items[i].UnitPriceAmount" class="form-control" data-item-field data-price-field />
                            </div>
                            <div class="form-group manual-item-product">
                                <label class="form-label">Produto interno</label>
                            <div class="product-picker">
                                <input type="search" class="form-control product-filter" placeholder="Filtrar produtos" aria-label="Filtrar produtos internos" />
                                <select asp-for="Items[i].ProductId" asp-items="products" class="form-select" data-item-field>
                                    <option value="">Sem vínculo</option>
                                </select>
                            </div>
                            </div>
                            <div class="manual-item-total">
                                <span>Total do item</span>
                                <strong data-item-total>R$ 0,00</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
        </div>

        <aside class="manual-order-summary">
            <div class="summary-card">
                <span class="eyebrow">Resumo</span>
                <dl>
                    <div>
                        <dt>Itens preenchidos</dt>
                        <dd id="manual-order-item-count">0</dd>
                    </div>
                    <div>
                        <dt>Total estimado</dt>
                        <dd id="manual-order-total">R$ 0,00</dd>
                    </div>
                </dl>
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-save fa-sm mr-1"></i>Salvar pedido
                </button>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary btn-block">Cancelar</a>
            </div>
        </aside>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const body = document.getElementById('order-items-body');
            const addButton = document.getElementById('add-order-item');
            const itemCount = document.getElementById('manual-order-item-count');
            const orderTotal = document.getElementById('manual-order-total');
            const currency = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

            const parseNumber = (value) => {
                const normalized = value.replace(/\./g, '').replace(',', '.');
                const parsed = Number.parseFloat(normalized);
                return Number.isFinite(parsed) ? parsed : 0;
            };

            const updateIndexes = () => {
                [...body.querySelectorAll('.order-item-row')].forEach((row, index) => {
                    row.querySelector('[data-item-number]').textContent = index + 1;

                    row.querySelectorAll('input, select').forEach((field) => {
                        if (field.name) {
                            field.name = field.name.replace(/Items\[\d+\]/, `Items[${index}]`);
                        }

                        if (field.id) {
                            field.id = field.id.replace(/Items_\d+__/, `Items_${index}__`);
                        }
                    });
                });
            };

            const updateSummary = () => {
                let filledItems = 0;
                let total = 0;

                [...body.querySelectorAll('.order-item-row')].forEach((row) => {
                    const description = row.querySelector('[data-description-field]').value.trim();
                    const quantity = parseNumber(row.querySelector('[data-quantity-field]').value);
                    const price = parseNumber(row.querySelector('[data-price-field]').value);
                    const rowTotal = quantity * price;
                    const title = row.querySelector('[data-item-title]');

                    row.querySelector('[data-item-total]').textContent = currency.format(rowTotal);
                    title.textContent = description || 'Novo item';

                    if (rowHasValue(row)) {
                        filledItems += 1;
                        total += rowTotal;
                    }
                });

                itemCount.textContent = filledItems;
                orderTotal.textContent = currency.format(total);
            };

            const clearRow = (row) => {
                row.querySelectorAll('input').forEach((field) => field.value = '');
                row.querySelectorAll('select').forEach((field) => field.selectedIndex = 0);
                row.querySelectorAll('option').forEach((option) => option.hidden = false);
                row.querySelector('[data-item-title]').textContent = 'Novo item';
                row.querySelector('[data-item-total]').textContent = currency.format(0);
            };

            const addRow = () => {
                const currentRows = body.querySelectorAll('.order-item-row');
                const clone = currentRows[currentRows.length - 1].cloneNode(true);
                clearRow(clone);
                body.appendChild(clone);
                updateIndexes();
                updateSummary();
            };

            const rowHasValue = (row) => {
                return [...row.querySelectorAll('[data-item-field]')].some((field) => {
                    if (field.tagName === 'SELECT') {
                        return field.value !== '';
                    }

                    return field.value.trim() !== '' && field.value !== '0';
                });
            };

            const ensureBlankLastRow = () => {
                const rows = body.querySelectorAll('.order-item-row');
                const lastRow = rows[rows.length - 1];
                if (rowHasValue(lastRow)) {
                    addRow();
                }
            };

            const filterProducts = (input) => {
                const picker = input.closest('.product-picker');
                const select = picker.querySelector('select');
                const query = input.value.trim().toLowerCase();

                [...select.options].forEach((option) => {
                    if (option.value === '') {
                        option.hidden = false;
                        return;
                    }

                    option.hidden = query.length > 0 && !option.text.toLowerCase().includes(query);
                });
            };

            body.addEventListener('input', (event) => {
                if (event.target.classList.contains('product-filter')) {
                    filterProducts(event.target);
                    return;
                }

                ensureBlankLastRow();
                updateSummary();
            });

            body.addEventListener('change', () => {
                ensureBlankLastRow();
                updateSummary();
            });

            body.addEventListener('click', (event) => {
                const removeButton = event.target.closest('[data-remove-item]');
                if (!removeButton) {
                    return;
                }

                const rows = body.querySelectorAll('.order-item-row');
                const row = removeButton.closest('.order-item-row');

                if (rows.length === 1) {
                    clearRow(row);
                } else {
                    row.remove();
                }

                updateIndexes();
                updateSummary();
            });

            addButton.addEventListener('click', addRow);
            updateIndexes();
            updateSummary();
        })();
    </script>
}
