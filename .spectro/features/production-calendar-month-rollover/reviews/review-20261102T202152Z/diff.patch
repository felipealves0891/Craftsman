--- /dev/null
+++ b/.codex/skills/spectro-gates/scripts/run_gate.mjs
@@ -0,0 +1,27 @@
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { parseArgs, existingDir, ensureDir, writeUtf8, runCommand, emitError } from '../../shared/runtime.mjs';
+
+export async function runGate({ command, workingDirectory, outputDirectory, timeoutSeconds = 900, evidencePath = '' }) {
+  const cwd = await existingDir(workingDirectory, 'WorkingDirectory');
+  await ensureDir(outputDirectory);
+  const output = path.resolve(outputDirectory);
+  const result = await runCommand(command, { cwd, outputDirectory: output, timeoutSeconds: Number(timeoutSeconds) });
+  const payload = { status: result.status, exit_code: result.exit_code, duration_ms: result.duration_ms, output: result.output || result.error || '' };
+  if (evidencePath) await writeUtf8(evidencePath, payload.output);
+  return payload;
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href) {
+  const args = parseArgs();
+  try {
+    const result = await runGate({ command: args.command, workingDirectory: args.workingDirectory || process.cwd(), outputDirectory: args.outputDirectory, timeoutSeconds: args.timeoutSeconds || 900, evidencePath: args.evidencePath || '' });
+    console.log(JSON.stringify(result));
+    process.exitCode = result.exit_code || 0;
+  } catch (error) {
+    const result = { status: 'error', exit_code: 1, duration_ms: 0, output: error.message };
+    if (args.evidencePath) await writeUtf8(args.evidencePath, result.output).catch(() => {});
+    console.log(JSON.stringify(result));
+    process.exitCode = 1;
+  }
+}
diff --git a/.codex/skills/spectro-gates/scripts/run_gate.ps1 b/.codex/skills/spectro-gates/scripts/run_gate.ps1
new file mode 100644
index 0000000..1ba0d16
--- /dev/null
+++ b/.codex/skills/spectro-gates/scripts/run_gate.ps1
@@ -0,0 +1,80 @@
+param(
+    [Parameter(Mandatory = $true)][string]$Command,
+    [Parameter(Mandatory = $true)][string]$WorkingDirectory,
+    [Parameter(Mandatory = $true)][string]$OutputDirectory,
+    [int]$TimeoutSeconds = 900,
+    [string]$EvidencePath = ""
+)
+
+$ErrorActionPreference = 'SilentlyContinue'
+
+$started = Get-Date
+$output = ""
+$status = "passed"
+$exitCode = 0
+
+try {
+    if (-not (Test-Path -LiteralPath $WorkingDirectory -PathType Container)) {
+        throw "WorkingDirectory must be an existing directory: $WorkingDirectory"
+    }
+    if (-not (Test-Path -LiteralPath $OutputDirectory -PathType Container)) {
+        New-Item -ItemType Directory -Force -Path $OutputDirectory | Out-Null
+    }
+    $resolvedWorkingDirectory = (Resolve-Path -LiteralPath $WorkingDirectory).Path
+    $resolvedOutputDirectory = (Resolve-Path -LiteralPath $OutputDirectory).Path
+    $job = Start-Job -ScriptBlock {
+        param($Text, $WorkingDirectory, $OutputDirectory)
+        try {
+            Set-Location -LiteralPath $WorkingDirectory
+            $env:SPECTRO_GATE_OUTPUT_DIR = $OutputDirectory
+            $captured = & ([scriptblock]::Create($Text)) 2>&1 | Out-String
+            [pscustomobject]@{
+                output = $captured
+                exit_code = if ($null -eq $LASTEXITCODE) { 0 } else { $LASTEXITCODE }
+            }
+        } catch {
+            [pscustomobject]@{
+                output = $_.Exception.Message
+                exit_code = 1
+            }
+        }
+    } -ArgumentList $Command, $resolvedWorkingDirectory, $resolvedOutputDirectory
+
+    if (-not (Wait-Job -Job $job -Timeout $TimeoutSeconds)) {
+        Stop-Job -Job $job
+        $status = "blocked"
+        $exitCode = 124
+        $output = "Command timed out after $TimeoutSeconds seconds."
+    } else {
+        $result = Receive-Job -Job $job -ErrorAction SilentlyContinue
+        $output = [string]$result.output
+        $exitCode = [int]$result.exit_code
+        if ($exitCode -ne 0) { $status = "failed" }
+        if ($job.State -eq "Failed") {
+            $status = "error"
+            $exitCode = 1
+        }
+    }
+} catch {
+    $status = "error"
+    $exitCode = 1
+    $output = $_.Exception.Message
+} finally {
+    if ($job) { Remove-Job -Job $job -Force -ErrorAction SilentlyContinue }
+}
+
+if ($EvidencePath) {
+    $parent = Split-Path -Parent $EvidencePath
+    if ($parent) { New-Item -ItemType Directory -Force -Path $parent | Out-Null }
+    Set-Content -Path $EvidencePath -Value $output -Encoding utf8
+}
+
+$durationMs = [int]((New-TimeSpan -Start $started -End (Get-Date)).TotalMilliseconds)
+[pscustomobject]@{
+    status = $status
+    exit_code = $exitCode
+    duration_ms = $durationMs
+    output = $output
+} | ConvertTo-Json -Depth 4
+
+if ($exitCode -ne 0) { exit $exitCode }
diff --git a/.codex/skills/spectro-gates/scripts/run_gates.mjs b/.codex/skills/spectro-gates/scripts/run_gates.mjs
new file mode 100644
index 0000000..6c3c482
--- /dev/null
+++ b/.codex/skills/spectro-gates/scripts/run_gates.mjs
@@ -0,0 +1,67 @@
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { pathToFileURL } from 'node:url';
+import { ensureDir, findProjectRoot, existingDir, existingFile, isFile, isDirectory, parseArgs, readJson, readUtf8, writeJson, writeUtf8, relativeUnix, sha256, gitRevision, scalar, listValue, commandsValue, inventory, isValidName, emitError } from '../../shared/runtime.mjs';
+import { runGate } from './run_gate.mjs';
+
+function aggregate(results) {
+  const failed = results.filter((gate) => gate.required && ['failed', 'blocked', 'error'].includes(gate.status));
+  if (!failed.length) return 'passed';
+  if (failed.some((gate) => gate.status === 'error')) return 'error';
+  if (failed.some((gate) => gate.status === 'blocked')) return 'blocked';
+  return 'failed';
+}
+
+export async function runGates({ featureId = 'workspace', configPath = '.spectro/config.yaml', projectRoot = '', continueOnFailure = false } = {}) {
+  const root = projectRoot ? await existingDir(projectRoot, 'ProjectRoot') : await findProjectRoot(process.cwd());
+  if (!isValidName(featureId)) throw new Error('FeatureId contains unsupported path characters.');
+  const configFullPath = await existingFile(path.resolve(root, configPath), 'ConfigPath');
+  const configText = await readUtf8(configFullPath);
+  const required = listValue(configText, 'required'), optional = listValue(configText, 'optional');
+  const commands = commandsValue(configText), timeoutSeconds = Number(scalar(configText, 'timeout_seconds', '900'));
+  const failFast = continueOnFailure ? false : scalar(configText, 'fail_fast', 'true') !== 'false';
+  const gateNames = [...new Set([...required, ...optional])];
+  if (!gateNames.length) throw new Error('No gates are configured.');
+  const featureDir = path.join(root, '.spectro', 'features', featureId);
+  const outputsRoot = path.join(featureDir, 'outputs'); await ensureDir(outputsRoot);
+  const executionBase = `gate-${new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z')}`;
+  let executionId = executionBase, counter = 1;
+  while (await isDirectory(path.join(outputsRoot, executionId))) executionId = `${executionBase}-${String(++counter).padStart(2, '0')}`;
+  const executionOutputDir = path.join(outputsRoot, executionId), evidenceDir = path.join(executionOutputDir, 'evidence');
+  await ensureDir(evidenceDir);
+  const started = Date.now(), results = [];
+  let blockedByFailFast = false;
+  for (let index = 0; index < gateNames.length; index += 1) {
+    const gateName = gateNames[index];
+    if (!isValidName(gateName)) throw new Error(`Gate name contains unsupported path characters: ${gateName}`);
+    const requiredGate = required.includes(gateName), command = commands[gateName] || '';
+    const evidencePath = path.join(evidenceDir, `${String(index + 1).padStart(2, '0')}-${gateName}.log`);
+    const gateOutputDir = path.join(executionOutputDir, gateName); await ensureDir(gateOutputDir);
+    const gate = { id: `GATE-${String(index + 1).padStart(3, '0')}`, name: gateName, required: requiredGate, status: 'skipped', command, exit_code: null, duration_ms: 0, diagnostics: [], evidence: [], output_directory: relativeUnix(root, gateOutputDir), output_files: [], output_file_count: 0 };
+    if (blockedByFailFast) { gate.status = 'blocked'; gate.diagnostics = ['Skipped because a previous required gate failed and fail-fast is enabled.']; await writeUtf8(evidencePath, gate.diagnostics.join('\n')); }
+    else if (!command.trim()) { gate.status = 'blocked'; gate.diagnostics = [`No command configured for gate '${gateName}'.`]; await writeUtf8(evidencePath, gate.diagnostics.join('\n')); if (requiredGate && failFast) blockedByFailFast = true; }
+    else {
+      const result = await runGate({ command, workingDirectory: root, outputDirectory: gateOutputDir, timeoutSeconds, evidencePath });
+      Object.assign(gate, { status: result.status, exit_code: result.exit_code, duration_ms: result.duration_ms });
+      if (result.status !== 'passed' && result.output) gate.diagnostics = [result.output.trim()];
+      if (requiredGate && failFast && result.status !== 'passed') blockedByFailFast = true;
+    }
+    if (await isFile(evidencePath)) gate.evidence = [relativeUnix(root, evidencePath)];
+    const found = await inventory(gateOutputDir); gate.output_files = found.files; gate.output_file_count = found.files.length; gate.diagnostics.push(...found.diagnostics);
+    results.push(gate);
+  }
+  const aggregateResult = aggregate(results), report = { schema_version: '1.0', feature_id: featureId, execution_id: executionId, project_root: root, code_revision: gitRevision(root), config_hash: `sha256:${await sha256(configFullPath)}`, artifact_hashes: {}, started_at: new Date(started).toISOString(), duration_ms: Date.now() - started, gates: results, result: aggregateResult };
+  for (const name of ['spec.md', 'clarifications.md', 'plan.md', 'tasks.md']) { const hash = await sha256(path.join(featureDir, name)); if (hash) report.artifact_hashes[name] = hash; }
+  await ensureDir(featureDir); const reportPath = path.join(featureDir, 'gates.json'); await writeJson(reportPath, report);
+  const oldState = await readJson(path.join(featureDir, 'state.json')).catch(() => null), phases = { ...(oldState?.phases || {}) }, attempts = { ...(oldState?.attempts || {}) };
+  phases.gates = { status: aggregateResult === 'passed' ? 'completed' : aggregateResult, execution_id: executionId, report: relativeUnix(root, reportPath) };
+  const state = { schema_version: '1.0', feature_id: featureId, current_phase: aggregateResult === 'passed' ? 'review' : 'gates', status: aggregateResult === 'passed' ? 'completed' : aggregateResult, phases, attempts, invalidated_executions: oldState?.invalidated_executions || [], last_failure: oldState?.last_failure || null, last_execution_id: executionId, updated_at: new Date().toISOString() };
+  await writeJson(path.join(featureDir, 'state.json'), state);
+  return report;
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href) {
+  const args = parseArgs();
+  try { const report = await runGates({ featureId: args.featureId || 'workspace', configPath: args.configPath || '.spectro/config.yaml', projectRoot: args.projectRoot || '', continueOnFailure: Boolean(args.continueOnFailure) }); console.log(JSON.stringify(report, null, 2)); process.exitCode = report.result === 'passed' ? 0 : 1; }
+  catch (error) { emitError(error); process.exitCode = 1; }
+}
diff --git a/.codex/skills/spectro-gates/scripts/run_gates.ps1 b/.codex/skills/spectro-gates/scripts/run_gates.ps1
new file mode 100644
index 0000000..4838322
--- /dev/null
+++ b/.codex/skills/spectro-gates/scripts/run_gates.ps1
@@ -0,0 +1,258 @@
+param(
+    [string]$FeatureId = "workspace",
+    [string]$ConfigPath = ".spectro/config.yaml",
+    [string]$ProjectRoot = "",
+    [switch]$ContinueOnFailure
+)
+
+$ErrorActionPreference = 'SilentlyContinue'
+$initialPath = (Get-Location).Path
+
+function Find-ProjectRoot([string]$StartPath) {
+    $current = (Resolve-Path -LiteralPath $StartPath).Path
+
+    while ($current) {
+        $currentLeaf = Split-Path -Leaf $current.TrimEnd('\')
+        if ($currentLeaf -eq '.spectro' -and (Test-Path -LiteralPath $current -PathType Container)) {
+            $parent = Split-Path -Parent $current
+            if ($parent) { return (Resolve-Path -LiteralPath $parent).Path }
+        }
+
+        $spectroPath = Join-Path $current '.spectro'
+        if (Test-Path -LiteralPath $spectroPath -PathType Container) {
+            return (Resolve-Path -LiteralPath $current).Path
+        }
+
+        $parent = Split-Path -Parent $current
+        if (-not $parent -or $parent -eq $current) { break }
+        $current = $parent
+    }
+
+    throw "Could not find an ancestor .spectro directory from the initial path: $StartPath"
+}
+
+if ([string]::IsNullOrWhiteSpace($ProjectRoot)) {
+    $root = Find-ProjectRoot $initialPath
+} else {
+    $root = (Resolve-Path -LiteralPath $ProjectRoot).Path
+}
+
+if (-not (Test-Path -LiteralPath $root -PathType Container)) {
+    throw "ProjectRoot must resolve to an existing directory: $root"
+}
+$configFullPath = (Resolve-Path -LiteralPath (Join-Path $root $ConfigPath)).Path
+
+if ($FeatureId -notmatch '^[A-Za-z0-9][A-Za-z0-9._-]*$') {
+    throw "FeatureId contains unsupported path characters."
+}
+
+function Get-Scalar([string]$Text, [string]$Key, [string]$Default) {
+    $match = [regex]::Match($Text, "(?m)^\s+$([regex]::Escape($Key)):\s*(.+?)\s*$")
+    if (-not $match.Success) { return $Default }
+    return $match.Groups[1].Value.Trim().Trim('"', "'")
+}
+
+function Get-List([string]$Text, [string]$Key) {
+    $match = [regex]::Match($Text, "(?m)^\s+$([regex]::Escape($Key)):\s*\[(.*?)\]\s*$")
+    if (-not $match.Success -or [string]::IsNullOrWhiteSpace($match.Groups[1].Value)) { return @() }
+    return @($match.Groups[1].Value.Split(',') | ForEach-Object { $_.Trim().Trim('"', "'") } | Where-Object { $_ })
+}
+
+function Get-Commands([string]$Text) {
+    $commands = @{}
+    $inCommands = $false
+    foreach ($line in ($Text -split "`r?`n")) {
+        if ($line -match '^\s{2}commands:\s*$') { $inCommands = $true; continue }
+        if ($inCommands -and $line -match '^\S') { $inCommands = $false }
+        if ($inCommands -and $line -match '^\s{4}([A-Za-z0-9._-]+):\s*(.*)$') {
+            $commands[$matches[1]] = $matches[2].Trim().Trim('"', "'")
+        }
+    }
+    return $commands
+}
+
+function Get-Sha256([string]$Path) {
+    if (Test-Path -LiteralPath $Path -PathType Leaf) { return (Get-FileHash -Algorithm SHA256 -LiteralPath $Path).Hash.ToLowerInvariant() }
+    return $null
+}
+
+function Get-CodeRevision {
+    try {
+        $revision = (& git -C $root rev-parse HEAD 2>$null | Out-String).Trim()
+        if ($LASTEXITCODE -eq 0 -and $revision) { return $revision }
+    } catch { }
+    return "uncommitted"
+}
+
+function Get-OutputInventory([string]$Directory) {
+    $files = @()
+    $diagnostics = @()
+    $resolvedDirectory = (Resolve-Path -LiteralPath $Directory).Path.TrimEnd('\') + '\'
+    foreach ($item in @(Get-ChildItem -LiteralPath $Directory -File -Recurse -Force -ErrorAction Stop)) {
+        if ($item.LinkType) {
+            $diagnostics += "Ignored linked output: $($item.FullName)"
+            continue
+        }
+        $resolvedFile = (Resolve-Path -LiteralPath $item.FullName).Path
+        if (-not $resolvedFile.StartsWith($resolvedDirectory, [System.StringComparison]::OrdinalIgnoreCase)) {
+            $diagnostics += "Ignored output outside gate directory: $($item.FullName)"
+            continue
+        }
+        $files += $resolvedFile.Substring($resolvedDirectory.Length).Replace('\', '/')
+    }
+    return [pscustomobject]@{
+        files = @($files | Sort-Object)
+        diagnostics = @($diagnostics)
+    }
+}
+
+$configText = Get-Content -Raw -Encoding utf8 -LiteralPath $configFullPath
+$required = @(Get-List $configText "required")
+$optional = @(Get-List $configText "optional")
+$commands = Get-Commands $configText
+$timeoutSeconds = [int](Get-Scalar $configText "timeout_seconds" "900")
+$failFast = (Get-Scalar $configText "fail_fast" "true") -ne "false"
+if ($ContinueOnFailure) { $failFast = $false }
+$gateNames = @($required + $optional | Select-Object -Unique)
+if ($gateNames.Count -eq 0) { throw "No gates are configured." }
+
+$featureDir = Join-Path $root (Join-Path ".spectro/features" $FeatureId)
+$outputsRoot = Join-Path $featureDir "outputs"
+$executionBase = "gate-{0}" -f (Get-Date).ToUniversalTime().ToString("yyyyMMddTHHmmssZ")
+$executionId = $executionBase
+$executionNumber = 1
+while (Test-Path -LiteralPath (Join-Path $outputsRoot $executionId)) {
+    $executionNumber++
+    $executionId = "{0}-{1:D2}" -f $executionBase, $executionNumber
+}
+$executionOutputDir = Join-Path $outputsRoot $executionId
+$evidenceDir = Join-Path $executionOutputDir "evidence"
+New-Item -ItemType Directory -Force -Path $evidenceDir | Out-Null
+$runner = Join-Path $PSScriptRoot "run_gate.ps1"
+$started = Get-Date
+$results = @()
+$blockedByFailFast = $false
+$index = 0
+
+foreach ($gateName in $gateNames) {
+    $index++
+    if ($gateName -notmatch '^[A-Za-z0-9][A-Za-z0-9._-]*$') {
+        throw "Gate name contains unsupported path characters: $gateName"
+    }
+    $requiredGate = $required -contains $gateName
+    $command = if ($commands.ContainsKey($gateName)) { [string]$commands[$gateName] } else { "" }
+    $evidencePath = Join-Path $evidenceDir ("{0:D2}-{1}.log" -f $index, $gateName)
+    $gateOutputDir = Join-Path $executionOutputDir $gateName
+    New-Item -ItemType Directory -Force -Path $gateOutputDir | Out-Null
+    $gate = [ordered]@{
+        id = "GATE-{0:D3}" -f $index
+        name = $gateName
+        required = $requiredGate
+        status = "skipped"
+        command = $command
+        exit_code = $null
+        duration_ms = 0
+        diagnostics = @()
+        evidence = @()
+        output_directory = $gateOutputDir.Substring($root.Length + 1).Replace('\', '/')
+        output_files = @()
+        output_file_count = 0
+    }
+
+    if ($blockedByFailFast) {
+        $gate.status = "blocked"
+        $gate.diagnostics = @("Skipped because a previous required gate failed and fail-fast is enabled.")
+        Set-Content -LiteralPath $evidencePath -Value ($gate.diagnostics -join "`n") -Encoding utf8
+        $gate.evidence = @($evidencePath.Substring($root.Length + 1).Replace('\', '/'))
+        $results += [pscustomobject]$gate
+        continue
+    }
+
+    if ([string]::IsNullOrWhiteSpace($command)) {
+        $gate.status = "blocked"
+        $gate.diagnostics = @("No command configured for gate '$gateName'.")
+        Set-Content -LiteralPath $evidencePath -Value ($gate.diagnostics -join "`n") -Encoding utf8
+        $gate.evidence = @($evidencePath.Substring($root.Length + 1).Replace('\', '/'))
+        $results += [pscustomobject]$gate
+        if ($requiredGate -and $failFast) { $blockedByFailFast = $true }
+        continue
+    }
+
+    $json = & powershell -NoProfile -ExecutionPolicy Bypass -File $runner -Command $command -WorkingDirectory $root -OutputDirectory $gateOutputDir -TimeoutSeconds $timeoutSeconds -EvidencePath $evidencePath 2>&1 | Out-String
+    $runnerExit = $LASTEXITCODE
+    try { $runResult = $json | ConvertFrom-Json } catch { $runResult = $null }
+    if ($null -eq $runResult) {
+        $gate.status = "error"
+        $gate.exit_code = if ($runnerExit) { $runnerExit } else { 1 }
+        $gate.diagnostics = @("Gate runner did not return valid JSON.", $json.Trim())
+    } else {
+        $gate.status = [string]$runResult.status
+        $gate.exit_code = [int]$runResult.exit_code
+        $gate.duration_ms = [int]$runResult.duration_ms
+        if ($gate.status -ne "passed") {
+            $diagnosticText = ([string]$runResult.output).Trim()
+            if ($diagnosticText) { $gate.diagnostics = @($diagnosticText) }
+        }
+    }
+    if (Test-Path -LiteralPath $evidencePath) { $gate.evidence = @($evidencePath.Substring($root.Length + 1).Replace('\', '/')) }
+    $inventory = Get-OutputInventory $gateOutputDir
+    $gate.output_files = @($inventory.files)
+    $gate.output_file_count = $gate.output_files.Count
+    if ($inventory.diagnostics.Count -gt 0) { $gate.diagnostics = @($gate.diagnostics + $inventory.diagnostics) }
+    $results += [pscustomobject]$gate
+    if ($requiredGate -and $failFast -and $gate.status -ne "passed") { $blockedByFailFast = $true }
+}
+
+$artifactHashes = [ordered]@{}
+foreach ($name in @("spec.md", "clarifications.md", "plan.md", "tasks.md")) {
+    $path = Join-Path $featureDir $name
+    $hash = Get-Sha256 $path
+    if ($hash) { $artifactHashes[$name] = $hash }
+}
+$requiredFailures = @($results | Where-Object { $_.required -and $_.status -in @("failed", "blocked", "error") })
+$aggregate = if ($requiredFailures.Count -gt 0) { if ($requiredFailures.status -contains "error") { "error" } elseif ($requiredFailures.status -contains "blocked") { "blocked" } else { "failed" } } else { "passed" }
+$report = [ordered]@{
+    schema_version = "1.0"
+    feature_id = $FeatureId
+    execution_id = $executionId
+    project_root = $root
+    code_revision = Get-CodeRevision
+    config_hash = "sha256:" + (Get-Sha256 $configFullPath)
+    artifact_hashes = $artifactHashes
+    started_at = $started.ToUniversalTime().ToString("o")
+    duration_ms = [int]((New-TimeSpan -Start $started -End (Get-Date)).TotalMilliseconds)
+    gates = @($results)
+    result = $aggregate
+}
+$reportPath = Join-Path $featureDir "gates.json"
+$report | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $reportPath -Encoding utf8
+$statePath = Join-Path $featureDir "state.json"
+$oldState = if (Test-Path -LiteralPath $statePath) { Get-Content -Raw -Encoding utf8 -LiteralPath $statePath | ConvertFrom-Json } else { $null }
+$phases = [ordered]@{}
+if ($oldState -and $oldState.phases) {
+    foreach ($phase in $oldState.phases.PSObject.Properties) { $phases[$phase.Name] = $phase.Value }
+}
+$phases.gates = [ordered]@{
+    status = if ($aggregate -eq "passed") { "completed" } else { $aggregate }
+    execution_id = $executionId
+    report = $reportPath.Substring($root.Length + 1)
+}
+$attempts = [ordered]@{}
+if ($oldState -and $oldState.attempts) {
+    foreach ($attempt in $oldState.attempts.PSObject.Properties) { $attempts[$attempt.Name] = $attempt.Value }
+}
+$state = [ordered]@{
+    schema_version = "1.0"
+    feature_id = $FeatureId
+    current_phase = if ($aggregate -eq "passed") { "review" } else { "gates" }
+    status = if ($aggregate -eq "passed") { "completed" } else { $aggregate }
+    phases = $phases
+    attempts = $attempts
+    invalidated_executions = if ($oldState) { @($oldState.invalidated_executions) } else { @() }
+    last_failure = if ($oldState) { $oldState.last_failure } else { $null }
+    last_execution_id = $executionId
+    updated_at = (Get-Date).ToUniversalTime().ToString("o")
+}
+$state | ConvertTo-Json -Depth 10 | Set-Content -LiteralPath $statePath -Encoding utf8
+Write-Output ($report | ConvertTo-Json -Depth 8)
+if ($aggregate -ne "passed") { exit 1 }
diff --git a/.codex/skills/spectro-gates/scripts/validate_gates.mjs b/.codex/skills/spectro-gates/scripts/validate_gates.mjs
new file mode 100644
index 0000000..9600adc
--- /dev/null
+++ b/.codex/skills/spectro-gates/scripts/validate_gates.mjs
@@ -0,0 +1,25 @@
+import path from 'node:path';
+import { existingFile, parseArgs, readJson, emitError } from '../../shared/runtime.mjs';
+
+export async function validateGates(reportPath) {
+  const report = await readJson(await existingFile(reportPath, 'ReportPath')), errors = [];
+  for (const field of ['schema_version', 'feature_id', 'execution_id', 'project_root', 'code_revision', 'config_hash', 'started_at', 'duration_ms', 'gates', 'result']) if (report[field] === undefined || report[field] === null) errors.push(`Missing field: ${field}`);
+  if (report.project_root && !path.isAbsolute(String(report.project_root))) errors.push('Invalid project_root: must be an absolute path');
+  if (report.schema_version !== '1.0') errors.push(`Unsupported schema_version: ${report.schema_version}`);
+  if (!['passed', 'failed', 'blocked', 'error'].includes(report.result)) errors.push(`Invalid aggregate result: ${report.result}`);
+  for (const gate of report.gates || []) {
+    for (const field of ['id', 'name', 'required', 'status', 'command', 'duration_ms', 'diagnostics', 'evidence']) if (gate[field] === undefined || gate[field] === null) errors.push(`${gate.name}: missing field ${field}`);
+    if (!['passed', 'failed', 'blocked', 'error', 'skipped'].includes(gate.status)) errors.push(`${gate.name}: invalid status ${gate.status}`);
+    if (gate.output_directory === undefined || gate.output_files === undefined || gate.output_file_count === undefined) errors.push(`${gate.name}: missing output contract`);
+    if (gate.output_directory !== undefined) {
+      if (!gate.output_directory || path.isAbsolute(gate.output_directory)) errors.push(`${gate.name}: output_directory must be relative`);
+      const expected = path.resolve(report.project_root, '.spectro', 'features', report.feature_id, 'outputs', report.execution_id);
+      const resolved = path.resolve(report.project_root, gate.output_directory);
+      if (path.relative(expected, resolved).startsWith('..')) errors.push(`${gate.name}: output_directory escapes the execution output directory`);
+    }
+    if (!Array.isArray(gate.output_files)) errors.push(`${gate.name}: output_files must be a list`);
+    else if (Number(gate.output_file_count) !== gate.output_files.length) errors.push(`${gate.name}: output_file_count does not match output_files`);
+  }
+  return errors;
+}
+const args = parseArgs(); try { const errors = await validateGates(args.reportPath); if (errors.length) { errors.forEach((e) => console.error(e)); process.exitCode = 1; } else console.log(`Gate report is valid: ${args.reportPath}`); } catch (error) { emitError(error); process.exitCode = 1; }
