+++ b/src/App/Views/Production/_Calendar.cshtml
@@ -0,0 +1,110 @@
+@using Craftsman.Domain.Production.Entities
+@using Craftsman.UI.Components.Shared
+@using System.Globalization
+@model IReadOnlyCollection<Craftsman.App.Models.ProductionTaskListItemViewModel>
+@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
+
+@{
+    var culture = CultureInfo.GetCultureInfo("pt-BR");
+    var tasks = Model.OrderBy(task => task.PlannedStartAt.ToLocalTime()).ToList();
+    DateOnly? selectedDate = ViewBag.PlannedDate is DateOnly plannedDateDateOnly ? plannedDateDateOnly : null;
+    var referenceDate = ViewBag.ReferenceDate is DateTime providedReferenceDate
+        ? providedReferenceDate
+        : selectedDate?.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today;
+    var monthStart = new DateTime(referenceDate.Year, referenceDate.Month, 1);
+    var monthKey = monthStart.ToString("yyyy-MM", CultureInfo.InvariantCulture);
+    var monthTitle = culture.TextInfo.ToTitleCase(monthStart.ToString("MMMM yyyy", culture));
+    var daysInMonth = DateTime.DaysInMonth(monthStart.Year, monthStart.Month);
+    var leadingBlankDays = ((int)monthStart.DayOfWeek + 6) % 7;
+    var tasksByDay = tasks
+        .SelectMany(task =>
+        {
+            var startDate = DateOnly.FromDateTime(task.PlannedStartAt.ToLocalTime().Date);
+            var endDate = DateOnly.FromDateTime(task.PlannedAt.ToLocalTime().Date);
+            var durationDays = Math.Max(1, endDate.DayNumber - startDate.DayNumber + 1);
+
+            return Enumerable.Range(0, durationDays)
+                .Select(offset => new
+                {
+                    Date = startDate.AddDays(offset),
+                    Task = task,
+                    IsStart = offset == 0,
+                    IsEnd = offset == durationDays - 1
+                });
+        })
+        .GroupBy(item => item.Date)
+        .ToDictionary(group => group.Key, group => group.ToList());
+    var today = ViewBag.Today is DateOnly currentDate
+        ? currentDate
+        : DateOnly.FromDateTime(DateTime.Today);
+    var visibleTaskCount = tasksByDay
+        .Where(group => group.Key.Year == monthStart.Year && group.Key.Month == monthStart.Month)
+        .SelectMany(group => group.Value.Select(item => item.Task.Id))
+        .Distinct()
+        .Count();
+
+    object? statusFilter = ViewBag.Status;
+    var selectedStatus = statusFilter is ProductionTaskStatus productionTaskStatus ? productionTaskStatus : (ProductionTaskStatus?)null;
+    var statusOptions = Craftsman.App.Presentation.EnumPresentation.SelectList(selectedStatus)
+        .Select(status => new SelectOption(status.Value ?? string.Empty, status.Text, status.Selected))
+        .ToArray();
+    var days = Enumerable.Range(1, daysInMonth)
+        .Select(day =>
+        {
+            var currentDate = DateOnly.FromDateTime(new DateTime(monthStart.Year, monthStart.Month, day));
+            var hasTasks = tasksByDay.TryGetValue(currentDate, out var dayTasks);
+            var dayClass = currentDate == today ? "calendar-day today" : "calendar-day";
+            var taskRows = (hasTasks && dayTasks is not null ? dayTasks : [])
+                .Select(item =>
+                {
+                    var task = item.Task;
+                    var startAt = task.PlannedStartAt.ToLocalTime();
+                    var endAt = task.PlannedAt.ToLocalTime();
+                    var rangeLabel = item.IsStart && item.IsEnd
+                        ? $"{startAt:HH\\:mm} - {endAt:HH\\:mm}"
+                        : item.IsStart
+                            ? $"Inicio {startAt:HH\\:mm}"
+                            : item.IsEnd
+                                ? $"Fim {endAt:HH\\:mm}"
+                                : "Em producao";
+
+                    return new ProductionIndexPage.ProductionTaskRow(
+                        task.Id,
+                        Craftsman.App.Presentation.EnumPresentation.Label(typeof(ProductionTaskStatus), task.Status),
+                        task.Status.ToLowerInvariant(),
+                        rangeLabel,
+                        task.OrderReference,
+                        task.ItemDescription,
+                        task.Quantity,
+                        task.ProductionDurationHours,
+                        task.CanStart,
+                        task.CanComplete,
+                        task.CanCancel);
+                })
+                .ToArray();
+
+            return new ProductionIndexPage.CalendarDay(day, dayClass, taskRows);
+        })
+        .ToArray();
+    var requestVerificationToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? string.Empty;
+    var plannedDate = selectedDate?.ToString("yyyy-MM-dd");
+    var errorMessage = TempData["Error"] as string;
+    var autoUpdate = selectedDate is null;
+}
+
+<div id="production-calendar-fragment"
+     data-current-month="@monthKey"
+     data-auto-update="@autoUpdate.ToString().ToLowerInvariant()"
+     data-month-url="@Url.Action("CurrentMonth", "Production")"
+     data-calendar-url="@Url.Action("Calendar", "Production")">
+    <component type="typeof(ProductionIndexPage)" render-mode="Static"
+               param-StatusOptions="@statusOptions"
+               param-PlannedDate="@plannedDate"
+               param-MonthTitle="@monthTitle"
+               param-VisibleTaskCount="@visibleTaskCount"
+               param-HasTasks="@tasks.Any()"
+               param-LeadingBlankDays="@leadingBlankDays"
+               param-RequestVerificationToken="@requestVerificationToken"
+               param-ErrorMessage="@errorMessage"
+               param-Days="@days" />
+</div>
diff --git a/src/App/wwwroot/js/production-calendar.js b/src/App/wwwroot/js/production-calendar.js
new file mode 100644
index 0000000..615e3ec
--- /dev/null
+++ b/src/App/wwwroot/js/production-calendar.js
@@ -0,0 +1,107 @@
+(() => {
+    const fragmentId = "production-calendar-fragment";
+    const initialFragment = document.getElementById(fragmentId);
+
+    if (!initialFragment || initialFragment.dataset.autoUpdate !== "true") {
+        return;
+    }
+
+    const monthUrl = initialFragment.dataset.monthUrl;
+    const calendarUrl = initialFragment.dataset.calendarUrl;
+    const pollIntervalMilliseconds = 30_000;
+    let requestInProgress = false;
+    let pollTimer;
+
+    function hasExplicitPlannedDate() {
+        return Boolean(document.querySelector("input[name='plannedDate']")?.value);
+    }
+
+    function getSelectedStatus() {
+        return document.querySelector("select[name='status']")?.value ?? "";
+    }
+
+    async function checkForMonthChange() {
+        if (requestInProgress || document.visibilityState !== "visible") {
+            return;
+        }
+
+        if (hasExplicitPlannedDate()) {
+            return;
+        }
+
+        requestInProgress = true;
+
+        try {
+            const monthResponse = await fetch(monthUrl, { cache: "no-store" });
+            if (!monthResponse.ok) {
+                return;
+            }
+
+            const month = await monthResponse.json();
+            const currentMonth = `${month.year}-${String(month.month).padStart(2, "0")}`;
+            const currentFragment = document.getElementById(fragmentId);
+
+            if (hasExplicitPlannedDate()
+                || !currentFragment
+                || currentFragment.dataset.autoUpdate !== "true"
+                || currentFragment.dataset.currentMonth === currentMonth) {
+                return;
+            }
+
+            const requestedStatus = getSelectedStatus();
+            const url = new URL(calendarUrl, window.location.origin);
+            if (requestedStatus) {
+                url.searchParams.set("status", requestedStatus);
+            }
+
+            const calendarResponse = await fetch(url, { cache: "no-store" });
+            if (!calendarResponse.ok) {
+                return;
+            }
+
+            const markup = await calendarResponse.text();
+            const template = document.createElement("template");
+            template.innerHTML = markup;
+            const replacement = template.content.querySelector(`#${fragmentId}`);
+            const latestFragment = document.getElementById(fragmentId);
+
+            if (!hasExplicitPlannedDate()
+                && latestFragment === currentFragment
+                && latestFragment.dataset.autoUpdate === "true"
+                && getSelectedStatus() === requestedStatus
+                && replacement?.dataset.currentMonth === currentMonth) {
+                latestFragment.replaceWith(replacement);
+            }
+        } catch {
+            // Keep the current calendar visible and retry on the next poll.
+        } finally {
+            requestInProgress = false;
+        }
+    }
+
+    function scheduleNextCheck() {
+        window.clearTimeout(pollTimer);
+        pollTimer = undefined;
+        if (document.visibilityState !== "visible") {
+            return;
+        }
+
+        pollTimer = window.setTimeout(async () => {
+            await checkForMonthChange();
+            scheduleNextCheck();
+        }, pollIntervalMilliseconds);
+    }
+
+    document.addEventListener("visibilitychange", () => {
+        if (document.visibilityState === "visible") {
+            void checkForMonthChange();
+            scheduleNextCheck();
+        } else {
+            window.clearTimeout(pollTimer);
+            pollTimer = undefined;
+        }
+    });
+
+    void checkForMonthChange();
+    scheduleNextCheck();
+})();
