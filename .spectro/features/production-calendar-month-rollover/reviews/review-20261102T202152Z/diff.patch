+# Spectro Init ÔÇö Contrato operacional
+
+## Managed paths
+
+The initializer manages only these paths:
+
+```text
+.spectro/
+Ôö£ÔöÇÔöÇ constitution.md
+Ôö£ÔöÇÔöÇ config.yaml
+Ôö£ÔöÇÔöÇ templates/
+Ôöé   Ôö£ÔöÇÔöÇ specification.md
+Ôöé   Ôö£ÔöÇÔöÇ clarifications.md
+Ôöé   Ôö£ÔöÇÔöÇ plan.md
+Ôöé   Ôö£ÔöÇÔöÇ tasks.md
+Ôöé   ÔööÔöÇÔöÇ review.md
+ÔööÔöÇÔöÇ features/
+```
+
+Files not listed above are unknown and must be preserved.
+
+## Result
+
+```yaml
+skill: spectro-init
+status: completed | completed_with_warnings | blocked | failed
+workspace: <normalized absolute path>
+root: <normalized absolute .spectro path>
+created: []
+preserved: []
+conflicts: []
+validation:
+  structure: passed | failed
+  config: passed | failed
+  templates: passed | failed
+```
+
+## Classification
+
+- `created`: destination did not exist and was written, or a missing directory was created.
+- `preserved`: destination already existed and was compatible or intentionally left untouched.
+- `conflict`: destination has the wrong type, invalid content, incompatible contract, or custom content that would be replaced.
+
+## Managed marker
+
+Generated files begin with a format-appropriate managed marker:
+
+```text
+<!-- spectro-managed: true -->
+```
+
+YAML files use `# spectro-managed: true`.
+
+`--force` can replace a conflicting regular file only when this marker is present. A project-owned file without the marker remains untouched and is reported as a conflict.
+
+## Status rules
+
+- `completed`: all mandatory validation passes and no blocking conflict exists.
+- `completed_with_warnings`: mandatory validation passes and only non-blocking preserved items or warnings exist.
+- `blocked`: a conflict or unavailable validation prevents asserting a valid installation.
+- `failed`: an operational error or mandatory validation failure occurred.
diff --git a/.codex/skills/spectro-init/scripts/init_spectro.ps1 b/.codex/skills/spectro-init/scripts/init_spectro.ps1
new file mode 100644
index 0000000..65b15ac
--- /dev/null
+++ b/.codex/skills/spectro-init/scripts/init_spectro.ps1
@@ -0,0 +1,165 @@
+[CmdletBinding()]
+param(
+    [string]$WorkspacePath = (Get-Location).Path,
+    [switch]$Force,
+    [switch]$DryRun,
+    [ValidateSet('text', 'json')]
+    [string]$Format = 'text'
+)
+
+$ErrorActionPreference = 'Stop'
+
+function Write-Utf8NoBom {
+    param([string]$Path, [string]$Content)
+    $encoding = New-Object System.Text.UTF8Encoding($false)
+    [IO.File]::WriteAllText($Path, $Content, $encoding)
+}
+
+function Test-ManagedFile {
+    param([string]$Path)
+    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { return $false }
+    $head = (Get-Content -LiteralPath $Path -TotalCount 3 -Encoding utf8) -join "`n"
+    return $head -match 'spectro-managed:\s*true'
+}
+
+function Add-Unique {
+    param([System.Collections.Generic.List[string]]$List, [string]$Value)
+    if (-not $List.Contains($Value)) { $List.Add($Value) }
+}
+
+function Emit-Report {
+    param([pscustomobject]$Report, [string]$OutputFormat)
+    if ($OutputFormat -eq 'json') {
+        $Report | ConvertTo-Json -Depth 12
+        return
+    }
+    Write-Output "spectro-init: $($Report.status)"
+    Write-Output "workspace: $($Report.workspace)"
+    Write-Output "root: $($Report.root)"
+    foreach ($field in @('created', 'replaced', 'preserved', 'conflicts')) {
+        $values = @($Report.$field)
+        if ($values.Count -gt 0) { Write-Output "${field}:"; $values | ForEach-Object { Write-Output "  - $_" } }
+    }
+    Write-Output "validation: structure=$($Report.validation.structure), config=$($Report.validation.config), templates=$($Report.validation.templates)"
+}
+
+$created = [System.Collections.Generic.List[string]]::new()
+$replaced = [System.Collections.Generic.List[string]]::new()
+$preserved = [System.Collections.Generic.List[string]]::new()
+$conflicts = [System.Collections.Generic.List[string]]::new()
+$warnings = [System.Collections.Generic.List[string]]::new()
+
+try {
+    $workspace = [IO.Path]::GetFullPath($WorkspacePath)
+    if (-not (Test-Path -LiteralPath $workspace -PathType Container)) {
+        throw "Workspace is not an accessible directory: $WorkspacePath"
+    }
+    $root = Join-Path $workspace '.spectro'
+    $assetRoot = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..\assets'))
+    $relativeFiles = [ordered]@{
+        'constitution.md' = 'constitution.md'
+        'config.yaml' = 'config.yaml'
+        'templates/specification.md' = 'templates/specification.md'
+        'templates/clarifications.md' = 'templates/clarifications.md'
+        'templates/plan.md' = 'templates/plan.md'
+        'templates/tasks.md' = 'templates/tasks.md'
+        'templates/review.md' = 'templates/review.md'
+    }
+
+    if (-not (Test-Path -LiteralPath $root)) {
+        if (-not $DryRun) { New-Item -ItemType Directory -Path $root -Force | Out-Null }
+        Add-Unique $created '.spectro'
+    } elseif (-not (Test-Path -LiteralPath $root -PathType Container)) {
+        Add-Unique $conflicts '.spectro is not a directory'
+    } else { Add-Unique $preserved '.spectro' }
+
+    foreach ($directory in @('templates', 'features')) {
+        $relative = ".spectro/$directory"
+        $destination = Join-Path $root $directory
+        if (Test-Path -LiteralPath $destination -PathType Leaf) {
+            Add-Unique $conflicts "$relative is a file"
+        } elseif (-not (Test-Path -LiteralPath $destination)) {
+            if (-not $DryRun) { New-Item -ItemType Directory -Path $destination -Force | Out-Null }
+            Add-Unique $created $relative
+        } else { Add-Unique $preserved $relative }
+    }
+
+    foreach ($entry in $relativeFiles.GetEnumerator()) {
+        $relativeDestination = ".spectro/$($entry.Key)"
+        $destination = Join-Path $root ($entry.Key -replace '/', [IO.Path]::DirectorySeparatorChar)
+        $source = Join-Path $assetRoot ($entry.Value -replace '/', [IO.Path]::DirectorySeparatorChar)
+
+        if (Test-Path -LiteralPath $destination -PathType Container) {
+            Add-Unique $conflicts "$relativeDestination is a directory"
+            continue
+        }
+        if (-not (Test-Path -LiteralPath $source -PathType Leaf)) {
+            Add-Unique $conflicts "missing packaged asset: $($entry.Value)"
+            continue
+        }
+
+        $assetContent = Get-Content -LiteralPath $source -Raw -Encoding utf8
+        if (-not (Test-Path -LiteralPath $destination)) {
+            if (-not $DryRun) { Write-Utf8NoBom $destination $assetContent }
+            Add-Unique $created $relativeDestination
+            continue
+        }
+
+        $existingContent = Get-Content -LiteralPath $destination -Raw -Encoding utf8
+        if ($existingContent -ceq $assetContent) {
+            Add-Unique $preserved $relativeDestination
+        } elseif ($Force -and (Test-ManagedFile $destination)) {
+            if (-not $DryRun) { Write-Utf8NoBom $destination $assetContent }
+            Add-Unique $replaced $relativeDestination
+        } else {
+            Add-Unique $conflicts "$relativeDestination contains custom or incompatible content"
+        }
+    }
+
+    $validationPath = Join-Path $PSScriptRoot 'validate_spectro.ps1'
+    $validation = [pscustomobject]@{
+        structure = 'failed'
+        config = 'failed'
+        templates = 'failed'
+        status = 'failed'
+        errors = @('validation skipped in dry-run')
+        warnings = @()
+    }
+    if (-not $DryRun -and $conflicts.Count -eq 0) {
+        $json = & $validationPath -WorkspacePath $workspace -AsObject 2>$null
+        if ($LASTEXITCODE -eq 0 -and $json) { $validation = $json | ConvertFrom-Json }
+    } elseif ($DryRun) {
+        $validation = [pscustomobject]@{ structure = 'not_run'; config = 'not_run'; templates = 'not_run'; status = 'not_run'; errors = @(); warnings = @('dry-run') }
+    }
+
+    $status = if ($conflicts.Count -gt 0) { 'blocked' } elseif ($DryRun) { 'completed_with_warnings' } elseif ($validation.status -eq 'failed') { 'failed' } elseif ($warnings.Count -gt 0) { 'completed_with_warnings' } else { 'completed' }
+    $report = [pscustomobject]@{
+        skill = 'spectro-init'
+        status = $status
+        workspace = $workspace
+        root = $root
+        created = @($created)
+        replaced = @($replaced)
+        preserved = @($preserved)
+        conflicts = @($conflicts)
+        validation = $validation
+    }
+    Emit-Report $report $Format
+    if ($status -in @('blocked', 'failed')) { exit 1 }
+    exit 0
+}
+catch {
+    $report = [pscustomobject]@{
+        skill = 'spectro-init'
+        status = 'failed'
+        workspace = $WorkspacePath
+        root = (Join-Path $WorkspacePath '.spectro')
+        created = @($created)
+        replaced = @($replaced)
+        preserved = @($preserved)
+        conflicts = @("operational error: $($_.Exception.Message)")
+        validation = [pscustomobject]@{ structure = 'failed'; config = 'failed'; templates = 'failed' }
+    }
+    Emit-Report $report $Format
+    exit 1
+}
diff --git a/.codex/skills/spectro-init/scripts/validate_spectro.ps1 b/.codex/skills/spectro-init/scripts/validate_spectro.ps1
new file mode 100644
index 0000000..2c001e9
--- /dev/null
+++ b/.codex/skills/spectro-init/scripts/validate_spectro.ps1
@@ -0,0 +1,101 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)]
+    [string]$WorkspacePath,
+    [switch]$AsObject
+)
+
+$ErrorActionPreference = 'Stop'
+
+function New-ValidationResult {
+    param([string]$Status, [string[]]$Errors, [string[]]$Warnings)
+    [pscustomobject]@{
+        structure = if ($Errors | Where-Object { $_ -like 'structure:*' }) { 'failed' } else { 'passed' }
+        config = if ($Errors | Where-Object { $_ -like 'config:*' }) { 'failed' } else { 'passed' }
+        templates = if ($Errors | Where-Object { $_ -like 'templates:*' }) { 'failed' } else { 'passed' }
+        status = $Status
+        errors = @($Errors)
+        warnings = @($Warnings)
+    }
+}
+
+try {
+    $workspace = [IO.Path]::GetFullPath($WorkspacePath)
+    if (-not (Test-Path -LiteralPath $workspace -PathType Container)) {
+        throw "Workspace is not an accessible directory: $WorkspacePath"
+    }
+
+    $root = Join-Path $workspace '.spectro'
+    $errors = [System.Collections.Generic.List[string]]::new()
+    $warnings = [System.Collections.Generic.List[string]]::new()
+
+    if (-not (Test-Path -LiteralPath $root -PathType Container)) {
+        $errors.Add('structure: missing .spectro directory')
+    }
+
+    foreach ($directory in @('templates', 'features')) {
+        $path = Join-Path $root $directory
+        if (-not (Test-Path -LiteralPath $path -PathType Container)) {
+            $errors.Add("structure: missing directory .spectro/$directory")
+        }
+    }
+
+    foreach ($file in @('constitution.md', 'config.yaml')) {
+        $path = Join-Path $root $file
+        if (-not (Test-Path -LiteralPath $path -PathType Leaf)) {
+            $errors.Add("structure: missing file .spectro/$file")
+        }
+    }
+
+    $templateNames = @('specification.md', 'clarifications.md', 'plan.md', 'tasks.md', 'review.md')
+    foreach ($name in $templateNames) {
+        $path = Join-Path $root (Join-Path 'templates' $name)
+        if (-not (Test-Path -LiteralPath $path -PathType Leaf)) {
+            $errors.Add("templates: missing file .spectro/templates/$name")
+        } elseif ([string]::IsNullOrWhiteSpace((Get-Content -LiteralPath $path -Raw -Encoding utf8))) {
+            $errors.Add("templates: empty file .spectro/templates/$name")
+        }
+    }
+
+    $configPath = Join-Path $root 'config.yaml'
+    if (Test-Path -LiteralPath $configPath -PathType Leaf) {
+        $config = Get-Content -LiteralPath $configPath -Raw -Encoding utf8
+        foreach ($required in @(
+            'version:',
+            'paths:',
+            'root:',
+            'features:',
+            'templates:',
+            'workflow:',
+            'states:',
+            'retry_limit:',
+            'recovery:',
+            'gates:'
+        )) {
+            if ($config -notmatch "(?m)^\s*$([regex]::Escape($required))") {
+                $errors.Add("config: missing required key $required")
+            }
+        }
+
+        if ($config -notmatch 'version:\s*["'']1\.0["'']') {
+            $errors.Add('config: unsupported or missing contract version')
+        }
+
+        foreach ($configuredPath in @('.spectro', '.spectro/features', '.spectro/templates')) {
+            if ($configuredPath.StartsWith('/') -or $configuredPath -match '^[A-Za-z]:') {
+                $errors.Add("config: absolute path is not allowed: $configuredPath")
+            }
+        }
+    }
+
+    $status = if ($errors.Count -gt 0) { 'failed' } elseif ($warnings.Count -gt 0) { 'passed_with_warnings' } else { 'passed' }
+    $result = New-ValidationResult -Status $status -Errors $errors -Warnings $warnings
+    if ($AsObject) { $result | ConvertTo-Json -Depth 8 } else { $result }
+    if ($errors.Count -gt 0) { exit 1 }
+    exit 0
+}
+catch {
+    $result = New-ValidationResult -Status 'failed' -Errors @("structure: $($_.Exception.Message)") -Warnings @()
+    if ($AsObject) { $result | ConvertTo-Json -Depth 8 } else { $result }
+    exit 1
+}
