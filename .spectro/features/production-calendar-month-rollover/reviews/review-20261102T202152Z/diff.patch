index 0000000..ea11232
--- /dev/null
+++ b/.codex/skills/spectro-gates/scripts/recover.mjs
@@ -0,0 +1,35 @@
+import path from 'node:path';
+import { parseArgs, existingDir, existingFile, ensureDir, readJson, readUtf8, writeJson, writeUtf8, relativeUnix, scalar, emitError } from '../../shared/runtime.mjs';
+import { runGate } from './run_gate.mjs';
+import { runGates } from './run_gates.mjs';
+
+const categories = new Set(['implementation-defect', 'test-defect', 'environment-failure', 'specification-gap', 'planning-defect', 'needs-human-review']);
+const stages = { 'implementation-defect': 'implement', 'test-defect': 'implement', 'environment-failure': 'gates', 'specification-gap': 'clarify', 'planning-defect': 'plan', 'needs-human-review': 'waiting_input' };
+
+export async function recover({ featureId, projectRoot = process.cwd(), configPath = '.spectro/config.yaml', failureCategory = '', gateReportPath = '', correctionCommand = '', resumeGates = false }) {
+  const root = await existingDir(projectRoot, 'ProjectRoot');
+  if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(featureId)) throw new Error('FeatureId contains unsupported path characters.');
+  const featureDir = path.join(root, '.spectro', 'features', featureId), statePath = path.join(featureDir, 'state.json');
+  const reportPath = await existingFile(gateReportPath || path.join(featureDir, 'gates.json'), 'GateReportPath');
+  const report = await readJson(reportPath), failedGates = (report.gates || []).filter((gate) => ['failed', 'blocked', 'error'].includes(gate.status));
+  if (!failedGates.length) throw new Error('The gate report contains no failed, blocked, or errored gates.');
+  const config = await readUtf8(path.resolve(root, configPath)), retryLimit = Number(scalar(config, 'retry_limit', '3')), timeoutSeconds = Number(scalar(config, 'timeout_seconds', '900'));
+  const failureKey = failureCategory || (failedGates.some((g) => ['blocked', 'error'].includes(g.status)) ? 'environment-failure' : 'needs-human-review');
+  if (!categories.has(failureKey)) throw new Error(`Unsupported failure category: ${failureKey}`);
+  const targetStage = stages[failureKey], state = await readJson(statePath).catch(() => ({ schema_version: '1.0', feature_id: featureId, current_phase: 'gates', status: 'failed', phases: {}, attempts: {}, invalidated_executions: [], last_failure: null }));
+  state.attempts ||= {};
+  const attemptProperty = `${failureKey}:${failedGates.map((g) => g.id).join(',')}`; state.attempts[attemptProperty] = Number(state.attempts[attemptProperty] || 0) + 1;
+  const attempt = state.attempts[attemptProperty];
+  state.current_phase = targetStage; state.status = attempt > retryLimit ? 'blocked' : 'waiting_input'; state.invalidated_executions = [...(state.invalidated_executions || []), report.execution_id];
+  state.invalidation_reason = `Recovery invalidated evidence for ${report.execution_id}.`; state.last_failure = { category: failureKey, stage: targetStage, execution_id: report.execution_id, gate_ids: failedGates.map((g) => g.id), diagnostics: failedGates.map((g) => `${g.name}: ${(g.diagnostics || []).join(' ')}`), detected_at: new Date().toISOString() };
+  if (attempt > retryLimit) { state.updated_at = new Date().toISOString(); await writeJson(statePath, state); console.log(`Retry limit exceeded for ${attemptProperty}. State is blocked.`); return 1; }
+  if (!correctionCommand) { state.updated_at = new Date().toISOString(); await writeJson(statePath, state); console.log(JSON.stringify(state, null, 2)); return 0; }
+  const recoveryOutputDir = path.join(featureDir, 'outputs', report.execution_id, 'recovery', `attempt-${String(attempt).padStart(2, '0')}`), recoveryEvidence = path.join(featureDir, 'outputs', report.execution_id, 'evidence', `recovery-${String(attempt).padStart(2, '0')}.log`);
+  await ensureDir(recoveryOutputDir); const correction = await runGate({ command: correctionCommand, workingDirectory: root, outputDirectory: recoveryOutputDir, timeoutSeconds, evidencePath: recoveryEvidence });
+  if (correction.status !== 'passed') { state.status = 'failed'; state.last_failure = { category: 'environment-failure', stage: targetStage, correction_status: 'failed', diagnostics: [correction.output] }; state.updated_at = new Date().toISOString(); await writeJson(statePath, state); console.log(JSON.stringify(correction)); return 1; }
+  state.status = 'completed'; state.current_phase = targetStage; state.last_failure = { category: failureKey, stage: targetStage, correction_status: 'passed', correction_evidence: relativeUnix(root, recoveryEvidence) }; state.updated_at = new Date().toISOString(); await writeJson(statePath, state); console.log(JSON.stringify(state, null, 2));
+  if (resumeGates && targetStage === 'gates') return (await runGates({ featureId, configPath, projectRoot: root })).result === 'passed' ? 0 : 1;
+  return 0;
+}
+
+const args = parseArgs(); try { process.exitCode = await recover({ featureId: args.featureId, projectRoot: args.projectRoot || process.cwd(), configPath: args.configPath || '.spectro/config.yaml', failureCategory: args.failureCategory || '', gateReportPath: args.gateReportPath || '', correctionCommand: args.correctionCommand || '', resumeGates: Boolean(args.resumeGates) }); } catch (error) { emitError(error); process.exitCode = 1; }
diff --git a/.codex/skills/spectro-gates/scripts/recover.ps1 b/.codex/skills/spectro-gates/scripts/recover.ps1
new file mode 100644
index 0000000..efceabb
--- /dev/null
+++ b/.codex/skills/spectro-gates/scripts/recover.ps1
@@ -0,0 +1,133 @@
+param(
+    [Parameter(Mandatory = $true)][string]$FeatureId,
+    [string]$ProjectRoot = (Get-Location).Path,
+    [string]$ConfigPath = ".spectro/config.yaml",
+    [ValidateSet("implementation-defect", "test-defect", "environment-failure", "specification-gap", "planning-defect", "needs-human-review")]
+    [string]$FailureCategory = "",
+    [string]$GateReportPath = "",
+    [string]$CorrectionCommand = "",
+    [switch]$ResumeGates
+)
+
+$ErrorActionPreference = "Stop"
+$root = (Resolve-Path -LiteralPath $ProjectRoot).Path
+if ($FeatureId -notmatch '^[A-Za-z0-9][A-Za-z0-9._-]*$') { throw "FeatureId contains unsupported path characters." }
+$featureDir = Join-Path $root (Join-Path ".spectro/features" $FeatureId)
+$statePath = Join-Path $featureDir "state.json"
+if (-not $GateReportPath) { $GateReportPath = Join-Path $featureDir "gates.json" }
+$reportPath = (Resolve-Path -LiteralPath $GateReportPath).Path
+
+function Get-Scalar([string]$Text, [string]$Key, [string]$Default) {
+    $match = [regex]::Match($Text, "(?m)^\s+$([regex]::Escape($Key)):\s*(.+?)\s*$")
+    if (-not $match.Success) { return $Default }
+    return $match.Groups[1].Value.Trim().Trim('"', "'")
+}
+
+function Get-Sha256([string]$Path) {
+    if (Test-Path -LiteralPath $Path -PathType Leaf) { return (Get-FileHash -Algorithm SHA256 -LiteralPath $Path).Hash.ToLowerInvariant() }
+    return ""
+}
+
+function Save-State($State) {
+    New-Item -ItemType Directory -Force -Path $featureDir | Out-Null
+    $State.updated_at = (Get-Date).ToUniversalTime().ToString("o")
+    $State | ConvertTo-Json -Depth 10 | Set-Content -LiteralPath $statePath -Encoding utf8
+}
+
+$configFullPath = (Resolve-Path -LiteralPath (Join-Path $root $ConfigPath)).Path
+$configText = Get-Content -Raw -Encoding utf8 -LiteralPath $configFullPath
+$retryLimit = [int](Get-Scalar $configText "retry_limit" "3")
+$timeoutSeconds = [int](Get-Scalar $configText "timeout_seconds" "900")
+$report = Get-Content -Raw -Encoding utf8 -LiteralPath $reportPath | ConvertFrom-Json
+$failedGates = @($report.gates | Where-Object { $_.status -in @("failed", "blocked", "error") })
+if ($failedGates.Count -eq 0) { throw "The gate report contains no failed, blocked, or errored gates." }
+
+$diagnosticText = (($failedGates | ForEach-Object { "$($_.name):$($_.status):$($_.exit_code):$($_.diagnostics -join ',')" }) -join "`n")
+$failureKey = if ($FailureCategory) { $FailureCategory } else { "needs-human-review" }
+if (-not $FailureCategory) {
+    if ($failedGates.status -contains "blocked" -or $failedGates.status -contains "error") { $failureKey = "environment-failure" }
+}
+$stageByCategory = @{
+    "implementation-defect" = "implement"
+    "test-defect" = "implement"
+    "environment-failure" = "gates"
+    "specification-gap" = "clarify"
+    "planning-defect" = "plan"
+    "needs-human-review" = "waiting_input"
+}
+$targetStage = $stageByCategory[$failureKey]
+
+$state = if (Test-Path -LiteralPath $statePath) { Get-Content -Raw -Encoding utf8 -LiteralPath $statePath | ConvertFrom-Json } else { $null }
+if ($null -eq $state) {
+    $state = [ordered]@{
+        schema_version = "1.0"
+        feature_id = $FeatureId
+        current_phase = "gates"
+        status = "failed"
+        phases = [pscustomobject]@{}
+        attempts = [pscustomobject]@{}
+        invalidated_executions = @()
+        last_failure = $null
+        updated_at = ""
+    }
+}
+if ($null -eq $state.attempts) { $state.attempts = [pscustomobject]@{} }
+$attemptProperty = ($failureKey + ":" + (($failedGates | ForEach-Object { $_.id }) -join ","))
+$attempts = @($state.attempts.PSObject.Properties | Where-Object { $_.Name -eq $attemptProperty })
+$attempt = if ($attempts.Count) { [int]$attempts[0].Value } else { 0 }
+$attempt++
+$lastFailure = [ordered]@{
+    category = $failureKey
+    stage = $targetStage
+    execution_id = $report.execution_id
+    gate_ids = @($failedGates | ForEach-Object { $_.id })
+    diagnostics = @($failedGates | ForEach-Object { "$($_.name): $($_.diagnostics -join ' ')" })
+    detected_at = (Get-Date).ToUniversalTime().ToString("o")
+}
+
+if ($state.attempts -is [hashtable]) { $state.attempts[$attemptProperty] = $attempt } else { $state.attempts | Add-Member -NotePropertyName $attemptProperty -NotePropertyValue $attempt -Force }
+if ($null -eq $state.phases) { $state | Add-Member -NotePropertyName phases -NotePropertyValue ([pscustomobject]@{}) }
+$state.current_phase = $targetStage
+$state.status = if ($attempt -gt $retryLimit) { "blocked" } else { "waiting_input" }
+$state.last_failure = [pscustomobject]$lastFailure
+if ($state.invalidated_executions -is [array]) { $state.invalidated_executions = @($state.invalidated_executions) + $report.execution_id } else { $state.invalidated_executions = @($report.execution_id) }
+$state | Add-Member -NotePropertyName invalidation_reason -NotePropertyValue "Recovery invalidated evidence for $($report.execution_id)." -Force
+
+if ($attempt -gt $retryLimit) {
+    Save-State $state
+    Write-Output "Retry limit exceeded for $attemptProperty. State is blocked."
+    exit 1
+}
+
+if (-not $CorrectionCommand) {
+    Save-State $state
+    Write-Output ($state | ConvertTo-Json -Depth 10)
+    exit 0
+}
+
+$executionOutputDir = Join-Path $featureDir (Join-Path "outputs" $report.execution_id)
+$recoveryOutputDir = Join-Path $executionOutputDir (Join-Path "recovery" ("attempt-{0:D2}" -f $attempt))
+$recoveryEvidence = Join-Path $executionOutputDir (Join-Path "evidence" ("recovery-{0:D2}.log" -f $attempt))
+$null = New-Item -ItemType Directory -Force -Path $recoveryOutputDir
+$runner = Join-Path $root "skills/spectro-gates/scripts/run_gate.ps1"
+$json = & powershell -NoProfile -ExecutionPolicy Bypass -File $runner -Command $CorrectionCommand -WorkingDirectory $root -OutputDirectory $recoveryOutputDir -TimeoutSeconds $timeoutSeconds -EvidencePath $recoveryEvidence 2>&1 | Out-String
+try { $correction = $json | ConvertFrom-Json } catch { $correction = $null }
+if ($null -eq $correction -or $correction.status -ne "passed") {
+    $state.status = "failed"
+    $state.last_failure = [pscustomobject](@{ category = "environment-failure"; stage = $targetStage; correction_status = "failed"; diagnostics = @($json.Trim()) })
+    Save-State $state
+    Write-Output $json
+    exit 1
+}
+
+$state.status = "completed"
+$state.current_phase = $targetStage
+$state.last_failure = [pscustomobject](@{ category = $failureKey; stage = $targetStage; correction_status = "passed"; correction_evidence = $recoveryEvidence.Substring($root.Length + 1) })
+Save-State $state
+Write-Output ($state | ConvertTo-Json -Depth 10)
+
+if ($ResumeGates -and $targetStage -eq "gates") {
+    $gateRunner = Join-Path $root "skills/spectro-gates/scripts/run_gates.ps1"
+    & powershell -NoProfile -ExecutionPolicy Bypass -File $gateRunner -FeatureId $FeatureId -ConfigPath $ConfigPath -ProjectRoot $root
+    exit $LASTEXITCODE
+}
diff --git a/.codex/skills/spectro-gates/scripts/run_gate.mjs b/.codex/skills/spectro-gates/scripts/run_gate.mjs
new file mode 100644
