+        await Assert.ThrowsAsync<InvalidOperationException>(() => service.SaveBillOfMaterialsAsync(new BillOfMaterialsInputModel
+        {
+            ProductId = product.Id,
+            Items = [new BillOfMaterialsItemInputModel { QuantityPerUnit = 1 }]
